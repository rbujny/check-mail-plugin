function formatPrice(r,t){const f=/\d+/g;if(!r||!f.test(r))return r||"";if(t=parseFloat(t),!t&&t!==0)return"";const c=r.match(f),o=r.split(f),g=o.pop(),d=o.shift();var e,i=c.length,s=o.length,n;if(i>1&&/^0+$/.test(c[i-1])?(i-=1,s-=1,t=t.toFixed(c[i].length).split("."),e=o[s]+t[1],t=t[0]):(t=t.toFixed(0),e=""),s>0)for(n=t.length;n>0;)i=i-1||1,n-=c[i].length,n>0&&(s=s&&s-1,t=t.slice(0,n)+o[s]+t.slice(n));return d+t+e+g}
