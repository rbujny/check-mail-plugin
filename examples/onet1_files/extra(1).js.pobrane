function extraInit(){$(document).on("enlargerOpen",function(){setTimeout(function(){offers[enlarger.flags.currentOffer].hasOwnProperty("cpRibbon")&&($(".offer-enlarger-extra-ribbon").css("display","block"),$(".offer-enlarger-extra-ribbon span").text(offers[enlarger.flags.currentOffer].cpRibbon))},300)}),$(document).on("enlargerClosed",function(){$(".offer-enlarger-extra-ribbon").css("display","none")})}
