ew\'}}" required></div><div ng-if=!hiddenPasswordTips ng-include="\'/change-password/views/password_tips.html\'" ng-model=passwordNew></div></div><div class=form-row><div nxt-input nxt-input-type=password nxt-input-name=passwordNewRepeat nxt-input-placeholder="Powtórz nowe hasło" nxt-input-error="changePassword.passwordNewRepeat.$valid && changePassword.passwordNewRepeat.$dirty" nxt-input-error-message="\'Hasła są różne\'" ng-model=passwordNewRepeat nxt-iwa-prefix="{{::\'board239\' + reason + \'PasswordNewRepeat\'}}" required></div></div><div class=dialog__buttons-container><button ng-disabled=formError class=button type=submit>Zapisz</button></div></form>'),a.put("o.iplsc.com/n/js/change-password/views/change_password_token.html",'<form ng-controller=ChangePasswordCtrl name=changePasswordToken class="change-password-form change-password-form--token" ng-submit=submit() novalidate><div class=change-password-form__new-password><div nxt-input nxt-input-type=password nxt-input-name=passwordNew nxt-input-placeholder="Nowe hasło" nxt-input-error="isNewPasswordBlur && newPasswordErrorMessage.length > 0 && changePasswordToken.passwordNew.$invalid && changePasswordToken.passwordNew.$dirty" nxt-input-error-message=newPasswordErrorMessage ng-blur="isNewPasswordBlur = true; blurNewPassword();" ng-focus=focusPassword() ng-model=passwordNew required></div><div ng-if=!hiddenPasswordTips ng-include="\'/change-password/views/password_tips.html\'" ng-model=passwordNew></div></div><div class=form-row><div nxt-input nxt-input-type=password nxt-input-name=passwordNewRepeat nxt-input-placeholder="Powtórz nowe hasło" nxt-input-error="changePasswordToken.passwordNewRepeat.$valid && changePasswordToken.passwordNewRepeat.$dirty" nxt-input-error-message="\'Hasła są różne\'" ng-blur=blurRepeatPassword(); ng-model=passwordNewRepeat required></div></div><div class=dialog__buttons-container><button ng-disabled=formError class=button type=submit>Zapisz</button><div class=link ng-click="closeLink()