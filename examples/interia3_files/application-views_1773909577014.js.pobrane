lass=\"{\n            'navigation-button--active': folder.id == $parent.activeFolderId && !$parent.isSearch\n       }\" ng-click=\"pushStats(folder.id); folderClickHandler();\" title=\"{{folder.name + ' (' + $parent.counters.total[folder.id] + ')'}}\" aria-label=Folder nxt-email-dropzone><span class=\"icon icon-folder\"></span><span class=navigation-item__name ng-bind=folder.name></span><div nxt-navigation-counter={{$parent.counters.userFolders[folder.id]}} nxt-navigation-counter-collapsed={{$parent.isCollapsed}} aria-hidden=true role=button></div></a><div nxt-dropdown nxt-dropdown-fixed=::dropdownTranslate nxt-dropdown-style=right nxt-dropdown-open-track=folderSettingMore><ul class=dropdown__list><li class=dropdown__item ng-click=editFolder(folder);>Edytuj<li ng-if=::!isSubfolder class=dropdown__item ng-click=toogleHidden(folder);>{{::folder.visibility ? 'Ukryj' : 'Pokaż'}}<li class=dropdown__item ng-click=deleteFolder(folder);>Usuń</ul></div></div>"),a.put("o.iplsc.com/n/js/newsfeed/views/bottom-nav.html",'<section ng-if=isNewsfeedOpen class="section section--newsfeed" nxt-newsfeed-main></section><section ng-if=isWeatherVisible nxt-weather-widget></section><nav class=bottom-nav ng-class="::{\n        \'bottom-nav--with-pbr\': isShowPbrBlik(),\n        \'bottom-nav--old-msglist\': isOldMsglist,\n    }" nxt-stop-touch-move-propagation><div class=bottom-nav__button ng-class="{\'bottom-nav__button--active\': isButtonActive(BUTTON_STATE.MAIL)}" ng-click=openMails()><div class="icon icon-messages"></div><div class=bottom-nav__button__text>Poczta</div></div><div class="bottom-nav__button bottom-nav__button--newsfeed" ng-class="{\'bottom-nav__button--active\': isButtonActive(BUTTON_STATE.NEWS)}" ng-click=openNewsfeed()><div nxt-bubble=14 nxt-bubble-extra-padd=::bubbleNewsfeedPadding></div><div ng-if=isBreakingNews nxt-bubble=-4 nxt-bubble-extra-padd=::breakingNewsBubblePadding></div><div ng-if=isLiveEvent class=bubble-container-mobile nxt-bubble=-5></div><div class="icon 