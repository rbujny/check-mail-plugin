oolbar__details__item__to>{{::(message.from.name || message.from.email || \'(brak nadawcy)\') | ellipsis:25}}, </span>{{::message.formatDate}}<li ng-if="::message.priority == \'high\'" class="message__toolbar__details__item icon icon-important selectable" data-tooltip="Ta wiadomość została oznaczona jako ważna"><li ng-if=::message.hasAtta class="message__toolbar__details__item icon icon-attachment selectable" data-tooltip="Ta wiadomość zawiera załączniki"></ul><ul class=message__toolbar__actions ng-show=::message.id><li class=message__toolbar__details__item ng-if=::!isEml><span class="icon icon-star" ng-class="{\'icon-star-full\': message.isStarred}" ng-click="markAsFavorite(message); $event.preventDefault();" data-tooltip="{{message.isStarred ? dataTooltip.REMOVE_STAR : dataTooltip.MARK_WITH_STAR}}" data-track-click="{{message.isStarred ? \'viewMailSetStar\' : \'\'}}" data-track-click-iwa="{{message.isStarred ? \'viewMailToolboxMarkFavourite\' : \'\'}}"></span><li class=message__toolbar__actions__item><span data-track-click-iwa=viewMailToolboxReply class="icon icon-reply" ng-click="reply(message); $event.preventDefault();" data-tooltip=Odpowiedz></span><li class=message__toolbar__actions__item><span class="icon icon-forward" ng-click="forward(message); $event.preventDefault();" data-track-click-iwa=viewMailToolboxForward data-tooltip={{::dataTooltip.FORWARD}}></span><li class=message__toolbar__actions__item ng-if=::!isEml><span ng-if=::folder.isTrash class="icon icon-trash" ng-click="deleteMessage($index); $event.preventDefault();" data-tooltip={{::dataTooltip.DELETE_MESSAGE}} data-track-click=viewMailToolbarDelete></span> <span class="icon icon-trash" ng-if=::!folder.isTrash ng-click="moveMessageFromThreadToTrash($index); $event.preventDefault();" data-tooltip={{::dataTooltip.DELETE_MESSAGE}} data-track-click=viewMailToolbarDelete></span><li class=message__toolbar__actions__item data-tooltip="Zobacz wszystkie opcje wiadomości" data-tooltip-top><div nxt-dropdown ng