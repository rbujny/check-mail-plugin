ition__header__actions><div nxt-dropdown nxt-dropdown-icon=arrow nxt-dropdown-open-track=newMailOptions data-tooltip={{::dataTooltip.COMPOSITION_OPTIONS}} class=composition__header__dropdown><ul class=dropdown__list><li class=dropdown__item ng-click="save({track: \'newMailSave\'})">Zapisz kopię roboczą</ul></div><div class="icon icon-minimize" ng-click="toggleMinimize(); $event.stopPropagation();" ng-mousedown=$event.stopPropagation(); data-tooltip="{{minimized ? dataTooltip.SHOW_COMPOSITION : dataTooltip.HIDE_COMPOSITION}}"></div><div class=icon ng-class="{\n                \'icon-maximize\': !maximized,\n                \'icon-demaximize\': maximized\n             }" ng-click="toggleMaximize(); $event.stopPropagation();" ng-mousedown=$event.stopPropagation(); data-tooltip="{{maximized ? dataTooltip.MINIMIZE_COMPOSITION : dataTooltip.MAXIMIZE_COMPOSITION}}"></div><div class="icon icon-close" ng-click="closeComposition(); $event.stopPropagation();" ng-mousedown=$event.stopPropagation(); data-tooltip={{::dataTooltip.CLOSE_COMPOSITION}}></div></div></div><div class=composition__wrapper nxt-file-dropzone ng-mousedown=activateComposition() ng-class="{\'sending-disabled\': !isSendingEnabled,\n        \'composition__wrapper--with-uploader\': uploader.queueLength,\n        \'composition__wrapper--transition\': isChangingSize\n     }" nxt-update-composition-size nxt-composition-scroll><div ng-if=uploader ng-class="{\'composition__actions__dropzone\': dropzone}" nv-file-drop uploader=uploader options="{url: uploadUrl}"></div><div class=composition-from nxt-simple-dropdown data-tooltip-horizontal-offset=15 data-tooltip-top><div class="icon icon-arrow"></div><div class=composition-from-selected ng-bind="sender.displayName ? (sender.displayName  + \' (\' + sender.name + \')\') : sender.name"></div><ul nxt-simple-dropdown-content class="composition-from-list dropdown"><li ng-repeat="a in filteredAccounts track by a.name" class=dropdown__item ng-class="{\'dropdown__item--active\': a.name === sender.name}" ng-click="$event.stopPropagation(); setSender(a)" ng-bind="::a.displayName ? (a.displayName + \' <\' + a.name + \'>\') : a.name" data-track-click-iwa=changeSenderMail><li ng-if="false && supplementaryEmail" class="dropdown__item link" ng-click=addAccount() data-track-click-iwa=compositionAddNewAccount>Napisz z innego adresu</ul></div><div class=email-input-plain-group nxt-email-input-plain-group nxt-to=to nxt-cc=cc nxt-bcc=bcc></div><div class=composition__subject-wrapper ng-show=$parent.id><div class=composition__subject nxt-input nxt-input-placeholder=Temat nxt-input-name=subject ng-model=subject ng-focus=emailInputsBlurred() ng-change=markCompositionAsModified()></div><div class="icon icon-important" ng-class="{\'icon-important--active\': isImportant}" ng-click=toggleImportant() data-tooltip={{::dataTooltip.COMPOSITION_IMPORTANT_MESSAGE}} aria-label="Oznacz wiadomość jako ważną" tabindex=-1></div></div><div ng-if=uploader><input tabindex=-1 type=file class=composition__uploader__fake-input nv-file-select uploader=uploader options="{url: uploadUrl}" multiple accesskey=u ng-focus=focusUploader($event)> <input tabindex=-1 type=file accept=image/* class=composition__uploader__fake-input nv-file-select uploader=uploader options="{isInline: true, url: inlineUploadUrl}" multiple></div><div class=composition__tinymce-wrapper><div ng-if="!isPlaceholderTouched() && compositionId" class=composition__textarea-placeholder-container><div class=composition__textarea-placeholder ng-click=focusEditor() ng-focus=focusEditor()>Wiadomość</div></div><div ng-if=!compositionId class=loader-wrapper nxt-loading-indicator></div><textarea ng-if=compositionId ui-tinymce ng-model=content ng-model-options="{debounce: 250}" class="composition-content modal-content" nxt-auto-grow={{!isHTML}}></textarea><div nxt-count-height ng-if="originalContent && !originalMessageRevealed" class=composition-reveal-original-message ng-click=revealOriginalMessage() title="Wyświetl treść wiadomości">&bull;&bull;&bull;</div><div ng-show=compositionId nxt-count-height nxt-signature nxt-selected-signature=selectedSignature></div><div ng-if=isPlaceholderTouched() class=composition__textarea-placeholder-container><div class="composition__textarea-placeholder composition__textarea-placeholder--touched" ng-class="{\'composition__textarea-placeholder--touched--selected\': selectedSignature}" ng-click=focusEditor() tabindex=-1>Wiadomość</div></div><div class=composition__dropzone ng-if="dropzone && !uploader.queueLength"><span>Upuść pliki tutaj</span></div><div ng-if=uploader.queueLength nxt-count-height class=upload-manager><div class=upload-manager__info ng-class="{\'upload-manager__info--error\': uploader.isTotalSizeExceeded || uploader.isItemsCountExceeded}"><div class=attachment__main-title>Załączniki - {{uploader.uploadedCount !== undefined ? uploader.uploadedCount : 0}} z {{uploader.queueLength}} <span class=attachment__main-title__size>({{uploader.uploadedSize !== undefined ? (uploader.uploadedSize|number:2) : 0}} z {{uploader.totalSize|number:2}} MB)</span><div ng-if=uploader ng-show=uploader.queueLength class=link ng-click=uploader.removeAllAttachments() ng-bind="uploader.isUploading ? \'Anuluj\' : \'Usuń wszystkie\'"></div></div><div ng-if=uploader.isItemsCountExceeded class=upload-manager__error><div class=upload-manager__error__title><span class="icon icon-dialog-warning"></span>Przekroczono liczbę załączników.</div><div class=upload-manager__error__desc>Dozwolona liczba załączników to {{::uploader.MAX_ITEMS_COUNT}}. Usuń część plików, aby pozostałe mogły zostać dodane do maila.</div></div><div ng-if=uploader.isTotalSizeExceeded class=upload-manager__error><div class=upload-manager__error__title><span class="icon icon-dialog-warning"></span>Przekroczono rozmiar załączników.</div><div class=upload-manager__error__desc>Łączny rozmiar załączników przekracza dozwolony limit {{isLargeFileAccept ? uploader.MAX_LARGE_FILE_TOTAL_SIZE : uploader.MAX_TOTAL_SIZE}} MB. Usuń część plików, aby pozostałe mogły zostać dodane do maila.</div></div></div><div ng-if="((uploader.showGalleryPanel && uploader.imgCount) || isLargeFileAccept) && isHTML && !isCorp && opt !== OPT.FORWARD" class=public-gallery-panel-enabled nxt-public-gallery nxt-public-gallery-message="" nxt-public-gallery-password=galleryPassword></div><div ng-if="uploader.showGalleryPanel && uploader.imgCount || isLargeFileAccept" class="attachments attachments-images"><div ng-if="isHTML && !isCorp && opt !== OPT.FORWARD"><div class=attachments__title>Galeria plików - <span class=attachments__title__gallery-state ng-class="{\n                                \'attachments__title__gallery-state--on\': galleryState,\n                                \'attachments__title__gallery-state--off\': !galleryState\n                            }" ng-bind="galleryState ? \'Włączona\' : \'Wyłączona\'"></span></div><ul ng-if="galleryPassword && galleryState" class=composition__gallery-list-info><li class=composition__gallery-list-info__item>Dostęp do galerii plików będzie ważny przez miesiąc od daty wysłania.<li class=composition__gallery-list-info__item><span class=composition__gallery-list-info__item-label>Hasło do plików:</span> <span class=composition__gallery-list-info__item-value>{{galleryPassword}}</span><li class=composition__gallery-list-info__item><span ng-if="!uploader.isUploading && !isSaving"><span class=composition__gallery-list-info__item-label>Link do plików:</span> <a ng-href={{prepareGalleryPreviewUrl()}} target=_blank class="link composition__gallery-list-info__item-value" data-track-click-iwa=compositionGalleryOptionsPreviewLink>kliknij tutaj </a></span><span ng-if="uploader.isUploading || isSaving">Trwa generowanie linku. Proces może zająć kilka sekund</span></ul></div><div><div ng-if=isGalleryAttachment(item) class=attachment ng-repeat="item in uploader.queue" title="{{item._file.name}} ({{item._file.size/1024/1024|number:2}} MB)" ng-hide=item.isInline ng-class="{\n                            uploaded: item.isUploaded,\n                            \'not-uploaded\': !item.isUploaded\n                        }"><div ng-include="\'/composition/views/attachment.html\'"></div></div><div ng-if=showAttachmentsAd nxt-ad-place=banner_zalacznik_next nxt-extra-keyword=attachmentsAdKeyword nxt-ad-device-dependent=false class=attachment__ad><div class=ad__header nxt-adv-close nxt-adv-close-name=banner_attachemnts>Reklama</div></div></div></div><div class="attachments attachments-other" ng-if=uploader.otherCount><div ng-if="uploader.showGalleryPanel && uploader.queue && uploader.imgCount" class="attachments__title attachments__title--other">Pozostałe załączniki:</div><div class=attachment ng-repeat="item in uploader.queue" ng-if=isNotGalleryAttachment(item) title="{{item._file.name}} ({{item._file.size/1024/1024|number:2}} MB)" ng-class="{uploaded: item.isUploaded, \'not-uploaded\': !item.isUploaded}"><div ng-include="\'/composition/views/attachment.html\'"></div></div><div ng-if=showAttachmentsAd nxt-ad-place=banner_zalacznik_next nxt-extra-keyword=attachmentsAdKeyword nxt-ad-device-dependent=false class=attachment__ad><div class=ad__header nxt-adv-close nxt-adv-close-name=banner_attachemnts>Reklama</div></div></div><div nxt-captcha ng-if=showingCaptcha></div></div><div class=composition-horizontal-line></div><div class=composition__basic-actions ng-mousedown=activateComposition() ng-class="{\'composition-basic__actions--inactive\': !isCompositionActive, \'mail-confirm-allowed\': mailConfirmAllowed}"><button ng-click=sendButtonClickHandler() class=button ng-class="{\'button--sending\': sending || (uploader && uploader.isUploading)}" ng-disabled="sending || (uploader && uploader.isUploading)">Wyślij <span ng-if="sending || (uploader && uploader.isUploading)" nxt-loading-indicator></span></button> <span ng-if=uploader ng-click=fileUploadClick() class="icon icon-attachment" nxt-bubble=5 nxt-bubble-extra-padd="[80, 0]" data-tooltip=