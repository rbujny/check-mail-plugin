ditionalData.selected}">{{sign.name}}</div></div></div><div class=dialog__buttons-container><button class=button ng-click=success();>Zapisz</button><button class="button button--cancel button--margin-left" ng-click=cancel()>Anuluj</button></div></div>'),a.put("o.iplsc.com/n/js/newsfeed/views/main.html",'<div class="newsfeed settings"><div ng-if=::!isMobile class=sidebar__title>Newsy<div class=sidebar__title__icons><span ng-if=$parent.$parent.openPanel class="sidebar-close icon icon-close" ng-click="$parent.$parent.$parent.closePanel(); profilingClose();" data-track-click-iwa=newsfeedCloseX></span></div></div><div ng-if=::isMobile><div class=navigation-header><div class="icon icon-hamburger navigation-header__hamburger" ng-class="{\'navigation-header__hamburger--with-counter\': unseenMessageCount}" ng-click="openNavigation(); $event.stopPropagation();"><div nxt-navigation-counter={{unseenMessageCount}} nxt-navigation-counter-sum></div></div><span class=navigation-header__title>Newsy</span></div></div><div class=newsfeed__settings nxt-dropdown nxt-dropdown-open-callback=openSettings() nxt-dropdown-close-callback=closeSettings() nxt-dropdown-icon=dots nxt-dropdown-open-track=newsfeedOpenSettings><ul class=dropdown__list><li class="dropdown__item no-close">Ustaw widoczność dodatków<li class=dropdown__separator><li class="dropdown__item no-close" ng-repeat="setting in settings" ng-click=changeSetting(setting.name)><input type=checkbox class="checkbox checkbox--switch" name=settings.weather ng-model=setting.value ng-attr-id="{{::\'newsfeed-setting-\' + setting.name}}"><label class="checkbox-label checkbox-label--switch no-close" ng-attr-for="{{::\'newsfeed-setting-\' + setting.name}}" ng-bind=::setting.text></label></ul></div><div class=newsfeed-container><div id=newsfeed class=newsfeed-main></div></div></div>'),a.put("o.iplsc.com/n/js/newsfeed/views/weather-widget.html",'<div class=weather-widget><div class=navigation-header><div class="icon icon-hamburger navigation-header__hamburger" ng-class="{\'navigation-header__hamburger--with-counter\': unseenMessageCount}" ng-click="openNavigation(); $event.stopPropagation();"><div nxt-navigation-counter={{unseenMessageCount}} nxt-navigation-counter-sum></div></div><span class=navigation-header__title>Pogoda</span></div><iframe id=weather-widget frameborder=0 ng-src={{weatherUrl()}} scrolling=no style="width: 100%" title="Weather Widget" height=100% allow=geolocation></iframe></div>'),a.put("o.iplsc.com/n/js/notification/views/mailNotification.html",'<section class=notification-container ng-show=messages.length><div class="notification__list-container notification__list-container--mail"><div class=notification__mail><div class=notification__mail__header><div class="icon icon-inbox"></div><span class=notification__mail__header__title ng-bind="\'Wiadomości odebranych: \' + messages.length"></span><div class=notification__actions><span ng-if="messages.length > 1" class=notification__mail__header__counter><span class="icon icon-arrow-left" ng-click="prev(); $event.stopPropagation();"></span> <span ng-bind="activeIndex + 1 + \' z \' + messages.length"></span> <span class="icon icon-arrow-right" ng-click="next(); $event.stopPropagation();"></span></span><div class="icon icon-close" ng-click="remove(); $event.stopPropagation();"></div></div></div><ul class=notification__mail__list><li ng-repeat="message in messages" ng-if="activeIndex === $index" class=notification__mail__item><div class=msglist-item__message><div class=msglist-item__message__precontainer><div class=msglist-avatar ng-show=avatarsShowed nxt-avatar nxt-avatar-list=message.avatarList nxt-avatar-contact-name=message.fromName nxt-avatar-contact-email=message.fromEmail nxt-avatar-options="{\'isCardEnabled\': false}" nxt-message-sender-info=message.senderInfo></div></div><div class=msglist-item__link ng-click=openMessage(message);><h2 class=msglist-item__message__sender ng-bind="::message.fromName || message.fromEmail || \'(brak nadawcy)\'" ng-attr-title="{{::message.fromName || message.fromEmail || \'(brak nadawcy)\'}}"></h2><div class=msglist-item__message__subject ng-attr-title="{{::message.subject || \'(brak tematu)\'}}"><span class=msglist-item__message__subject-folder ng-bind=::foldersMap[message.folderId].name></span><span ng-if="::message.priority === \'high\'" class="icon icon-important"> </span><span ng-if="::message.hasAtta && !message.billing" class="icon icon-attachment"></span><span class=msglist-item__message__subject-text ng-bind="::(message.subject || \'(brak tematu)\')"></span></div></div><div class=msglist-item__message__postcontainer><span class=icon ng-class="message.isStarred ? \'icon-star-full\' : \'icon-star\'" ng-click="markAsFavorite(message); $event.stopPropagation();" data-tooltip="{{message.isStarred ? \'Oznaczone gwiazdką\' : \'Nieoznaczone gwiazdką\'}}"></span></div></div></ul></div></div><audio ng-if=::audioNotification id=audioNotification><source ng-src="{{::audioFile + \'.ogg\'}}" type=audio/ogg><source ng-src="{{::audioFile + \'.mp3\'}}" type=audio/mpeg></audio></section>'),a.put("o.iplsc.com/n/js/notification/views/mainNotification.html",'<div class=notification-container><div class=notification__list-container ng-show=notifications.length ng-mouseenter=stopInterval() ng-mouseleave=startInterval()><ul class=notification__list><li class=notification__list__item ng-class="::\'notification__list__item--\' + notification.type" ng-repeat="notification in notifications"><div class="notification__icon icon icon-dialog-{{::notification.type}}"></div><div class=notification__message role=alert nxt-bind-html-compile=::notification.message></div><div class="icon icon-close" ng-click="removeNotification($index); $event.preventDefault();"></div></ul></div></div>'),a.put("o.iplsc.com/n/js/placeholder-loading/views/navigation-system-folders.html",'<ul class="navigation-list navigation-list--system placeholder-loading"><li ng-repeat="folder in foldersSystem" class=navigation-it