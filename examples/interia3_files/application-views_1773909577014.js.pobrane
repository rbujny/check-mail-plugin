r: phrase.val | limitTo: phraseLimit" ng-class="{\'search-suggestions__item--selected\': selectedSuggestIndex === $index}" ng-click=searchSuggestion(suggestion);><span class=search-suggestions__item__text ng-bind=::suggestion data-track-click-iwa=useSuggestSearch></span> <span class="icon icon-close" ng-click="removeSuggestion($index); $event.preventDefault(); $event.stopPropagation();"></span><li class=search-suggestions__item ng-show=phrase.val ng-click=searchFrom(phrase.val)><span data-track-click-iwa=useSuggestSearch ng-bind="\'Od: \' + phrase.val"></span><li class=search-suggestions__item ng-show=phrase.val ng-click=searchTo(phrase.val)><span data-track-click-iwa=useSuggestSearch ng-bind="\'Do: \' + phrase.val"></span></ul><div class=search-advanced ng-show="isSearchFormActive && isSearchAdvanced"><div class=input-container><ul ui-select class="ui-select-container--search input--select" ng-model=filters.folder name=search_folder id=search-folder data-track-change=searcherOptionFolder data-track-change-iwa=searcherOptionFolder ng-click=selectSearchFolder($select)><li ui-select-match class=ui-select-match--search>{{$select.selected.name}} <span class="icon icon-arrow"></span><li ui-select-choices repeat="folder.id as folder in folders"><span ng-bind=folder.name></span></ul><hr class=input-line><span class=ui-select__placeholder>Szukaj w folderze</span></div><div nxt-input nxt-input-placeholder=Od nxt-input-name=search_from ng-model=filters.from ng-focus="pushIWACode(\'searcherOptionFrom\')"></div><div nxt-input nxt-input-placeholder=Do nxt-input-name=search_to ng-model=filters.to ng-focus="pushIWACode(\'searcherOptionTo\')"></div><div nxt-input nxt-input-placeholder="Temat wiadomości" class=search__subject nxt-input-name=search_subject ng-model=phrase.val ng-focus="pushIWACode(\'searcherOptionTopic\')"></div><div class=calendar-wrapper ng-class="{\'calendar-wrapper__modal\': datePickerFromShow || datePickerToShow}"><div nxt-pickadate ng-model=filters.date_from class="date-form-container date-form-container--margin-right"><div nxt-input nxt-input-placeholder="Zakres dat" nxt-input-name=search_date_form nxt-input-autocomplete=off ng-model=filters.date_from nxt-input-pattern=datePattern ng-focus="openPicker(\'datePickerFromShow\'); pushIWACode(\'searcherOptionDateFrom\')" readonly></div><div ng-show=datePickerFromShow ng-mouseenter="focusElement(\'.date-from\');" class="pickadate-wrapper date-from"><div class="pickadate pickadate-modal" ng-model=filters.date_from pickadate week-starts-on=1 min-date=minDate max-date=maxDate no-extra-rows></div><div class=pickadate-wrapper__buttons><button type=button class=button ng-click="closePicker(\'datePickerFromShow\')">Zamknij</button><button type=button class="button button--cancel button--margin-left" ng-click="today(\'datePickerFromShow\');">Dziś</button></div></div><div ng-if=filters.date_from ng-click="clearDate(\'date_from\')" class="icon icon-close"></div></div><div nxt-pickadate ng-model=filters.date_to class=date-form-container><div nxt-input nxt-input-placeholder=do nxt-input-name=search_date_to nxt-input-autocomplete=off ng-model=filters.date_to nxt-input-pattern=datePattern ng-focus="openPicker(\'datePickerToShow\'); pushIWACode(\'searcherOptionDateTo\')" readonly></div><div ng-show=datePickerToShow ng-mouseenter="focusElement(\'.date-to\');" class="pickadate-wrapper date-to"><div class="pickadate pickadate-modal" ng-model=filters.date_to pickadate week-starts-on=1 min-date=minDate max-date=maxDate no-extra-rows></div><div class=pickadate-wrapper__buttons><button type=button class=button ng-click="closePicker(\'datePickerToShow\')">Zamknij</button><button type=button class="button button--cancel button--margin-left" ng-click="today(\'datePickerToShow\')">Dziś</button></div></div><div ng-if=filters.date_to ng-click="clearDate(\'date_to\')" class="icon icon-close"></div></div></div><div class=search-advanced__options><div class=search-advanced__options__item><input type=checkbox class=checkbox name=search_attachments id=search-attachments ng-model=filters.with_attachments data-track-change=searcherOptionAttach data-track-change-iwa=searcherOptionAttach><label for=search-attachments class="checkbox-label checkbox-label--small label">Pokaż tylko wiadomości z załącznikami</label></div><div class="search-advanced__options__item search-advanced__options__item--margin-top"><input type=checkbox class=checkbox ng-model=filters.isSearchInContent id=search-in-content-advanced><label for=search-in-content-advanced class="checkbox-label checkbox-label--small">Szukaj w treści wiadomości</label></div></div><div class=search__buttons-containter ng-show="isExpanded && isSearchAdvanced"><button type=submit class=button>Szukaj</button><button type=button class="button button--cancel button--margin-left" value=Anuluj ng-click="closeAdvanced(); focusElement(\'#search\');" data-track-click=searcherAdvanceClose>Anuluj</button></div></div><div ng-if=!isSearchAdvanced class=search-options ng-class="{\'search-options--without-suggestions\': suggestions.length === 0}" ng-show=isSearchFormActive><span class=link ng-click=openAdvanced($event)>Pokaż opcje wyszukiwania</span> <span class=search__in-content><input type=checkbox class=checkbox ng-model=filters.isSearchInContent id=search-in-content><label for=search-in-content class="checkbox-label checkbox-label--small">szukaj w treści</label></span></div></div></form></section>'),a.put("o.iplsc.com/n/js/folder/views/spoof_warn_dialog.html",'<div class=spoof-warn><p class="spoof-warn__item spoof-warn__item-subtitle">Wiadomość została wysłana z innego adresu niż ten widoczny w polu „Nadawca”. Co to oznacza? <a class=link target=_blank href={{::params.additionalData.helpUrl}}>Dowiedz się więcej ></a><p class="spoof-warn__item spoof-warn__item-from"><span class=spoof-warn__item-label><span class="icon icon-arrow-right"></span> Adres nadawcy: </span><span class=spoof-warn__item-content>{{::params.additionalData.fromEmail}}</span><p class="spoof-warn__item spoof-warn__item-from"><span class=spoof-warn__item-label><span class="icon icon-arrow-right"></span> Adres kopertowy (wysyłającego): </span><span class=spoof-warn__item-content>{{::params.additionalData.envelopeEmail}}</span><div class=spoof-warn__button><button class="button button--go" ng-click=success();>Rozumiem</button></div></div>'),a.put("o.iplsc.com/n/js/limited-confirm-requirement/views/dialog-limited-confirm-requirement.html",'<div class=poczta-pro-promotion__wrapper><div class=poczta-pro-promotion__content><div class=poczta-pro-promotion__header><img ng-src="{{::staticUrl + \'/public/images/poczta-pro/logo-poczta-pro.svg\'}}" width=137 height=16 alt="Logo PocztaPRO" class=poczta-pro-promotion__header-logo><div class=poczta-pro-promotion__header-title>Nie wiesz, czy e-mail dotarł?</div></div><div class=poczta-pro-promotion__copy><div class=poczta-pro-promotion__copy-text-title>Masz <b>3 potwierdzenia</b> odczytu miesięcznie.<br>Chcesz więcej? Włącz PocztaPRO.</div></div></div><div class=poczta-pro-promotion__buttons><a class="button button--go" target=_blank href="https://ustawienia-pocztowe.interia.pl/#/aktywuj-pakiet?utm_source=autopromo_pdf&utm_medium=plansza&utm_campaign=potw_odczytu" ng-click=close()>Włącz PocztaPRO </a><button class="button button--link button--margin-top" ng-click=cancel()>Dziękuję, innym razem</button></div></div>'),a.put("o.iplsc.com/n/js/live-event/views/bubble.html",'<div class="bubble bubble--{{bubbleData.name}}" id=bubble-{{bubbleId}} ng-show=!templateParams.closedBubble nxt-stop-click-propagation><span class="icon icon-close" ng-click=close();></span><div class=bubble__content ng-click="clickLink($event, bubbleData.options)"><span class=bubble__content__label ng-if=::bubbleData.options.label ng-bind-html=::bubbleData.options.label></span><div class=bubble__content--title>Euro 2024 relacja z meczu na żywo</div></div></div>'),a.put("o.iplsc.com/n/js/message/views/header_mobile.html",'<header class="message-header message-header--sticky" ng-if=!isNewspapersMessage ng-class="{\n                \'message-header--single-message\': thread.length < 2\n            }"><h1 class=message-header__subject ng-attr-title="{{::firstFullMessage.subject || \'(brak tematu)\'}}"><span class="icon icon-arrow-back" ng-click="back(); $event.preventDefault();$event.stopPropagation();"></span> <span class=message-header__subject__text ng-bind="::firstFullMessage.subject || \'(brak tematu)\'"></span></h1><div ng-if="messageId > 0" class=message-header__toolbar ng-class="{\n                \'message-header__toolbar--without-speech-icon\': speech.icon === speechIconStates[0],\n                \'message-header__toolbar--thread\' : thread.length >= 2\n            }"><div class=message__toolbar__actions__item><div ng-if="speech.icon !== speechIconStates[0] && !isEml && thread.length >= 2" class=message__toolbar__actions__item><span class="message voiceAssistant-icon" ng-click="speechToggle(\'message\'); $event.preventDefault()" nxt-speech-icon-animation nxt-background-color="\'light\'"></span><div class="message message--thread" nxt-bubble=-2 nxt-bubble-extra-padd="[80, 0]"></div></div><span ng-if="!isEml && thread.length >= 2" class="icon icon-trash" ng-click="folder.isTrash ? deleteMessage() : moveToTrash()"></span><div ng-if="thread.length < 2"><ul class=message__toolbar__actions ng-show=::thread[0].id><li class=message__toolbar__details__item ng-if="speech.icon !== speechIconStates[0]"><span class="message voiceAssistant-icon" ng-click="speechToggle(\'message\'); $event.preventDefault()" nxt-speech-icon-animation nxt-background-color="\'light\'"></span><div class=message nxt-bubble=-2 nxt-bubble-extra-padd="[80, 0]"></div><li class=message__toolbar__details__item ng-if=::!isEml><span class="icon icon-star" ng-class="{\'icon-star-full\': thread[0].isStarred}" ng-click="markAsFavorite(thread[0]); $event.preventDefault();" data-track-click="{{thread[0].isStarred ? \'viewMailSetStar\' : \'\'}}" data-track-click-iwa="{{thread[0].isStarred ? \'viewMailToolboxMarkFavourite\' : \'\'}}"></span><li class=message__toolbar__actions__item><span data-track-click-iwa=viewMailToolboxReply class="icon icon-reply" ng-click="reply(thread[0]); $event.preventDefault();"></span><li class=message__toolbar__actions__item ng-if=::!isEml><span ng-if=::folder.isTrash class="icon icon-trash" ng-click="deleteMessage(0); $event.preventDefault();" data-track-click=viewMailToolbarDelete></span> <span class="icon icon-trash" ng-if=::!folder.isTrash ng-click="moveMessageFromThreadToTrash(0); $event.preventDefault();" data-track-click=viewMailToolbarDelete></span><li class=message__toolbar__actions__item><div nxt-dropdown ng-if="userFolders.length !== undefined" ng-init="isLast = false" nxt-dropdown-change=isLast nxt-dropdown-open-track=viewMailMoreOptionsShow><ul class=dropdown__list><li class=dropdown__item ng-show=!isReplyingToSingle ng-click=replyToSender(thread[0])>Odpowiedz tylko nadawcy<li class=dropdown__item ng-show=isReplyingToSingle ng-click=replyToAll(thread[0])>Odpowiedz wszystkim<li class=dropdown__item ng-click=forward(thread[0]); data-track-click-iwa=viewMailToolboxForward>Prześlij dalej<li class=dropdown__item ng-if="thread[0].folderId !== folders.SPAM && !isEml" ng-click=moveToSpam(thread[0])>Oznacz jako spam<li class=dropdown__item ng-if="thread[0].folderId === folders.SPAM && !isEml" ng-click=moveToUnSpam(thread[0])>To nie jest spam!<li ng-if="!folder.isTrash && !isEml" class=dropdown__item ng-click=moveToTrash()>Usuń cały wątek<li class=dropdown__item ng-if="folder.isTrash && !isEml" ng-click=deleteMessage()>Usuń cały wątek<li ng-if=::!isEml data-label="Przenieś do folderu" class="dropdown__item scroll-no-hide dropdown__nav dropdown__nav--next">Przenieś do folderu<ul class="force-no-hide scroll-no-hide dropdown__list"><li class=dropdown__item ng-click="moveFunctions[folder.moveFunction](thread[0], folder.id)" ng-repeat="folder in moveFolders | orderBy: folder.order">{{::folder.name}}</li><div ng-if="userFolders.length > 0" class=dropdown__separator></div><li class="dropdown__item scroll-no-hide user-folder" ng-class="{\'user-folder--with-sub\': folder.subFolders && folder.subFolders.length}" ng-repeat="folder in userFolders" ng-init="$parent.isLast = $last"><a ng-click="moveToFolder(folder.id, thread[0])" class=scroll-no-hide>{{::folder.name}}</a><ul class="dropdown__list scroll-no-hide" ng-if="folder.subFolders && folder.subFolders.length"><li class="dropdown__item scroll-no-hide user-folder--sub" ng-repeat="subfolder in folder.subFolders" ng-click=moveToFolder(subfolder.id)>{{::subfolder.name}}</ul></ul><li class=dropdown__item ng-click=print(thread[0]) ng-if="::!isEml && !isMobileApp">Drukuj<li class=dropdown__item ng-click=showDetails(thread[0])>Szczegóły wiadomości<li class=dropdown__item ng-click=sendAsAttachment(thread[0])>Prześlij jako załącznik</ul></div></ul></div></div></div></header>'),a.put("o.iplsc.com/n/js/message/views/iframe.html",'<iframe class=message-iframe accesskey=m title="{{:: \'Wiadomość: \' + message.subject}}" aria-live=polite src=about:blank style="display: block!important"></iframe>'),a.put("o.iplsc.com/n/js/message/views/main.html",'<div ng-if=!firstFullMessage class=message__outher-wrapper><header class=message-header><h1 class=message-header__subject></h1></header><div class="message-section-container loader-container" nxt-loading-indicator></div></div><div class=message__outher-wrapper nxt-ui-events-data="{\'panel\': \'message\'}" ng-if=firstFullMessage nxt-sticky-header><header class=message-header ng-if=!isNewspapersMessage><h1 class=message-header__subject ng-attr-title="{{::firstFullMessage.subject || \'(brak tematu)\'}}"><span ng-bind="::firstFullMessage.subject || \'(brak tematu)\'"></span></h1></header><div ng-if="messagesToLoadCount > 0 || showOldMessages === false" class="message__load-all link" ng-click=loadOldMessages() ng-bind="\'Zobacz starsze wiadomości (\' + messagesToLoadCountPerm + \')\'"></div><div ng-if="messagesToLoadCount === 0 && showOldMessages" class="message__load-all link" ng-click=hideOldMessages() ng-bind="::\'Ukryj starsze wiadomości\'"></div><div class=message-section-container ng-class="{\n            \'single-message\': thread.length < 2,\n                [\'single-message--\' + thread[0].name]: thread[0].name\n            }"><div class=message-all-wrapper><div ng-repeat="message in thread track by message.id" ng-if="showOldMessages || !message.isOld" ng-class="{\n                    \'message--opened\': message.isFull,\n                    \'message--closed\': !message.isFull,\n                    \'message--billing\': message.billing\n                 }" class=message><div ng-if=message.isFull class=message__container><div ng-include="\'/message/views/toolbar.html\'"></div><div ng-show=isStickyHeaderActive class=message__toolbar-container--sticky ng-include="\'/message/views/toolbar.html\'"></div><section class=message__details ng-if=message.isDetailsVisible><table class=message__details__table><tr class=message__details__table__row ng-repeat="h in message.parsedHeaders"><td class="message__details__table__cell message__details__table__key" ng-bind=h.key><td class="message__details__table__cell message__details__table__value" ng-bind-html=h.value></table></section><div ng-if=::message.deliveryReport class=message__info-bar-container nxt-info-bar></div><div class="message__content-actions message__images-status" ng-if="message.imgProtect === 1"><span class=message__images-status__action ng-if=!isForcedShowImages ng-click=showImages(message) data-tooltip="Dla twojego bezpieczeństwa zablokowaliśmy obrazki. Kliknij aby je zobaczyć">Pokaż obrazki </span><span class=message__images-status__action ng-if=isForcedShowImages ng-click=showImages(message) data-tooltip="Obrazki zostały odblokowane. Kliknij aby ponownie je zablokować">Ukryj obrazki </span><span class="message__images-status__action message__images-status__action--always-show" ng-if=message.from.email ng-click=alwaysShowImages(message) ng-bind="::\'Zawsze pokazuj obrazki od \' + (message.from.name || message.from.email)" ng-on-load=viewMailAlwaysShowImg(message) data-tooltip="Dla twojego bezpieczeństwa zablokowaliśmy obrazki. Kliknij aby zawsze pokazywać obrazki od tego adresata"></span></div><div class="message__content-actions message__safety-sender" ng-if=message.senderInfo.safe><i class="icon icon-padlock" data-tooltip-bubble=0></i> <span>Ta wiadomość pochodzi od Bezpiecznego Nadawcy - <a target=_blank class=link ng-href={{safetySenderReadMoreUrl}}>Dowiedz się więcej</a></span></div><div class=message__content ng-class="::{\'message__content--mailing\': message.isMailing}" nxt-scale-message nxt-scale-message-sender=::message.from.email><div ng-if=!isNewspapersMessage nxt-scroll-detector nxt-message-iframe nxt-message-iframe-data=message class=message__iframe></div><div ng-if=isNewspapersMessage nxt-message-newspapers-iframe></div></div><div class=after-content nxt-public-gallery nxt-public-gallery-message=message></div><div class=message__attachments ng-if=::message.attachmentsLength><div ng-if=::dangerousAttachment class=message__attachments__dangerous><div class=message__attachments__dangerous__content><h1 class=message__attachments__dangerous__title>Uwaga! Ten załącznik może zawierać niebezpieczne treści.</h1><p class=message__attachments__dangerous__description>Jeśli nie znasz nadawcy maila - nie pobieraj załącznika!</div><i class="icon icon-important-triangle"></i></div><div class=message__attachments__header><div ng-if=!message.senderInfo.safe class=message__attachments__actions>{{::\'Załączniki - \' + message.attachmentsLength}} <span class=message__attachments__actions__size>&nbsp;({{::formatSize(message.attaSize)}})</span></div><div ng-if=message.senderInfo.safe class=message__attachments__actions>{{::\'Załączniki od zweryfikowanego nadawcy - \' + message.attachmentsLength}} <span class=message__attachment