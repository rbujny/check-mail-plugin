der-radius: 5px;width: 100%; padding: 8px 8px 0"><tr><td><img ng-src="{{::staticUrl + \'/public/images/autopromo/mail/interia.jpg\'}}" width=680 height=244 alt=Interia style=width:100%;height:auto></table><table style="max-width: 680px;margin: 0 auto;;border-radius: 5px;width: 100%; padding: 0 8px 8px"><tr><td style="font-size: 24px;text-align: center"><p style="margin: 16px auto; font-weight: 500">Zobacz ciekawostki ze świata<tr ng-repeat="article in articles"><td><div class=article style="max-width: 680px; background-color: #f3f5f8; margin: 0 auto 16px"><a ng-href={{::article.url}} class=article__img-link target=_blank><img class=article__img ng-src="{{::staticUrl + \'/public/images/autopromo/mail/\' + article.img}}" width=450 height=auto></a><div class=article__content style="background-color: #F7F7F7; margin-top: 16px; padding: 16px 16px 24px"><p style="padding: 8px; background-color: #e2e7ee; display: inline; border-radius: 5px">{{::article.label}}<p style="font-size: 18px; margin: 24px 0 0;font-weight: 400">{{::article.desc}}<hr style="border: none; height: 1px; background-color: #808080; margin-top: 18px"><a ng-href={{::article.url}} target=_blank style="display: inline-block; color: #3872ff; margin-top: 18px; margin-bottom: 0; font-weight: 680; text-decoration: underline">Czytaj więcej</a></div></div><tr><td><div style="max-width: 680px; margin: 24px auto 0"><img ng-src="{{::staticUrl + \'/public/images/autopromo/mail/logo.png\'}}" width=85 height=24></div></table></div>'),a.put("o.iplsc.com/n/js/promotion-place/views/billing-mail.html",'<div class=container><style>.container {\n            color: #2a2d34;\n            max-width: 740px;\n            text-align: center;\n        }\n\n        h1 {\n            font-size: 37px;\n            font-weight: bold;\n            margin: 24px 0 0;\n        }\n\n        .desc-billing {\n            font-size: 19px;\n            line-height: 29px;\n            margin-top: 32px;\n        }\n\n        h2 {\n            font-size: 19px;\n            margin: 0;\n        }\n\n        .benefit-title {\n            margin: 37px 0 0;\n            border-top: 1px solid #e2e2e2;\n            padding-top: 34px;\n        }\n\n        .benefit__item {\n            display: inline-block;\n            margin-top: 37px;\n            max-width: 49.5%;\n            vertical-align: top;\n        }\n\n        .benefit__item__img-container {\n            height: 110px;\n        }\n\n        .desc {\n            font-size: 16px;\n            line-height: 22px;\n            margin-top: 12px;\n        }\n\n        .instruction {\n            background-color: #f7f7f7;\n            margin-top: 34px;\n            padding-bottom: 74px;\n            padding-top: 36px;\n        }\n\n        .instruction__item {\n            background-color: #fff;\n            box-shadow: 0 0 30px 0 rgba(0, 0, 0, .2);\n            display: inline-block;\n            margin-top: 35px;\n            padding: 14px 10px;\n            position: relative;\n            vertical-align: top;\n            width: 40%;\n        }\n\n        .instruction__item--1 {\n            margin-right: 40px;\n        }\n\n        .instruction__item img {\n            margin-top: 16px;\n        }\n\n        .instruction__item .desc {\n            line-height: 20px;\n        }\n\n        .instruction__item__counter {\n            background-color: #2f9fff;\n            border-radius: 100%;\n            box-shadow: 0 0 15px 0 rgba(0, 0, 0, .1);\n            color: #fff;\n            font-weight: bold;\n            height: 27px;\n            left: 20px;\n            line-height: 27px;\n            position: absolute;\n            top: -12px;\n            width: 27px;\n        }\n\n        .link {\n            color: #2f9fff;\n            position: relative;\n            text-decoration: none;\n            z-index: 2;\n        }\n\n        .footer {\n            padding: 30px;\n        }\n\n        .billing-board-open {\n            bottom: 0;\n            cursor: pointer;\n            position: absolute;\n            left: 0;\n            right: 0;\n            top: 0;\n        }\n\n        @media (max-width: 550px) {\n            .benefit__item {\n                max-width: 95%;\n            }\n\n            .instruction__item {\n                width: 85%;\n            }\n\n            .instruction__item--1 {\n                margin-right: 0;\n            }\n        }</style><div><img ng-src="{{::imagePath + \'portfel.png\'}}" width=84 height=84 alt=""><h1>Rachunki</h1><div class=desc-billing>Już dziś zacznij korzystać z folderu Rachunki!</div></div><h2 class=benefit-title>Co zyskujesz?</h2><div class=benefit__item><div class=benefit__item__img-container><img ng-src="{{::imagePath + \'skrzynka.png\'}}" width=87 height=90 alt=""></div><h2>Porządek</h2><div class=desc>Wszystkie maile z fakturami za prąd, gaz, telefon, kablówkę itd., od&nbsp;teraz w&nbsp;jednym folderze.</div></div><div class=benefit__item><div class=benefit__item__img-container><img ng-src="{{::imagePath + \'hamak.png\'}}" width=93 height=84 alt=""></div><h2>Wygodę</h2><div class=desc>E-faktury możesz opłacać bezpośrednio na&nbsp;Twojej skrzynce mailowej.</div></div><div class=benefit__item><div class=benefit__item__img-container><img ng-src="{{::imagePath + \'tarcza.png\'}}" width=72 height=88 alt=""></div><h2>Bezpieczeństwo</h2><div class=desc>Nie pomylisz prawdziwego rachunku z&nbsp;podrobionym przez oszustów.</div></div><div class=benefit__item><div class=benefit__item__img-container><img ng-src="{{::imagePath + \'dzwonek.png\'}}" width=72 height=82 alt=""></div><h2>Spokój</h2><div class=desc>Przypomnimy Ci o&nbsp;nadchodzącym terminie płatności.</div></div><div class=instruction><h2>Jak to zrobić?</h2><div class="instruction__item instruction__item--1"><div class=instruction__item__counter>1</div><img ng-src="{{::imagePath + \'folder.png\'}}" width=140 height=42 alt=""><div class=desc>Kliknij w folder Rachunki, aby go aktywować.</div></div><div class=instruction__item><div class=instruction__item__counter>2</div><div class=desc>Włącz e-faktury u swoich dostawców i ustaw Twój adres e-mail do otrzymywania dokumentów elektronicznych.<br><a class=link href="https://pomoc.poczta.interia.pl/news-jak-wlaczyc-e-faktury-za-telefon-prad-kablowke-internet,nId,3089911?utm_source=imitacja_mail&utm_medium=email&utm_campaign=interia_rachunki" target=_blank>Dowiedz się więcej</a></div></div></div><div class=footer><img ng-src="{{::imagePath + \'logo.png\'}}" width=152 height=18 alt=""></div><div class=billing-board-open id=inpl-billing-board-open></div></div>'),a.put("o.iplsc.com/n/js/promotion-place/views/bok-mail-email-in-own-domain-with-link.html",'<div class=bok-container style="display: flex; flex-direction: row; justify-content: center"><div style="position: relative"><a ng-href={{::additionalData.learnMoreUrl}}><img alt="Mail informacyjny" class=inpl-inline-attachment ng-src={{::bokMailImage}}></a></div></div>'),a.put("o.iplsc.com/n/js/promotion-place/views/bok-mail-with-link.html",'<div class=bok-container style="display: flex; flex-direction: row; justify-content: center"><div style="position: relative"><img class=inpl-inline-attachment ng-src={{::bokMailImage}} alt="Mail informacyjny"> <a ng-href={{::additionalData.settingsUrl}} ng-if=!isMobile style="height: 7%;\n                left: 25%;\n                position: absolute;\n                top: 50%;\n                width: 17%"></a> <a ng-href={{::additionalData.settingsUrl}} ng-if=isMobile style="height: 4%;\n                left: 40%;\n                position: absolute;\n                top: 49%;\n                width: 30%"></a></div></div>'),a.put("o.iplsc.com/n/js/promotion-place/views/bok-mail.html",'<div class=bok-container style="display: flex; flex-direction: row; justify-content: center"><img class=inpl-inline-attachment ng-src={{::bokMailImage}} alt="Mail informacyjny"></div>'),a.put("o.iplsc.com/n/js/promotion-place/views/bok-mobile-app.html",'