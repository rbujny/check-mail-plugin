Handler($index)><div nxt-avatar nxt-avatar-list=c[ContactKeys.AVATAR] class=avatar data-tooltip-stop-propagation></div><span ng-if=::!isMobile class=email-input-plain__suggest-element__text ng-bind-html="c[ContactKeys.NAME] + \' (\' + c[ContactKeys.EMAIL] + \')\' | searchHighlight:inputEmail"></span><div ng-if=::isMobile class=email-input-plain__suggest-element__text><div class=email-input-plain__suggest-element__text__name ng-bind-html="c[ContactKeys.NAME] | searchHighlight:inputEmail"></div><div class=email-input-plain__suggest-element__text__mail ng-bind-html="c[ContactKeys.EMAIL] | searchHighlight:inputEmail"></div></div><li class="email-input-plain__suggest-element dropdown__item" ng-repeat="group in groups track by group.id" ng-class="{selected: selectedGroupIndex === $index}" ng-mouseover=suggestGroupHoverHandler($index) ng-click=addGroupContacts(group.id)><div class=avatar><div class="avatar__content avatar__content--group"></div></div><div class="email-input-plain__suggest-element__text group" ng-bind-html="\'Grupa: \' + (group.name | searchHighlight:inputEmail)"></div></ul></div>'),a.put("o.iplsc.com/n/js/composition/views/emailInputPlainGroup.html",'<div ng-show="!(isEditing.val || allRecipients.bcc.length || allRecipients.cc.length)" class=composition-all-recipients ng-click=startEditing() title={{recipients}}>{{recipients}}</div><div ng-show="recipientsCounter > 0 && !isEditing.val" class=composition-ommited-counter ng-click=startEditing()>(w sumie {{recipientsCounter}})</div><div ng-show="isEditing.val || (allRecipients.to.length && !isEditing.val && (allRecipients.cc.length || allRecipients.bcc.length))" nxt-is-editing=isEditing.val nxt-email-input-plain nxt-name=composition-to class=composition-to nxt-basevalue=to ng-blur=update()></div><div ng-show=isEditing.val class=composition-switches><div ng-show=!isCCShown class="composition-show composition-show--cc link" ng-click="showCC(true); $event.preventDefault()" data-tooltip={{::dataTooltip.SHOW_CC}} data-tooltip-horizontal-offset=-5 data-tooltip-top>DW</div><div ng-show=!isBCCShown class="composition-show composition-show--bcc link" ng-click="showBCC(true); $event.preventDefault()" data-tooltip={{::dataTooltip.SHOW_BCC}} data-tooltip-top>UDW</div></div><div ng-show="(isCCShown && isEditing.val) || (allRecipients.cc.length && !isEditing.val)" nxt-is-editing=isEditing.val nxt-email-input-plain nxt-name=composition-cc class=composition-cc nxt-basevalue=cc ng-blur=update() data-tooltip-stop-propagation></div><div ng-show="(isBCCShown && isEditing.val) || (allRecipients.bcc.length && !isEditing.val)" nxt-is-editing=isEditing.val nxt-email-input-plain nxt-name=composition-bcc class=composition-bcc nxt-basevalue=bcc ng-blur=update() data-tooltip-stop-propagation></div>'),a.put("o.iplsc.com/n/js/composition/views/emailInputPlainGroup_mobile.html",'<div class=composition-ommited-counter ng-show="recipientsCounter > 0 && !isEditing.val" ng-click=startEditing()>(w sumie {{recipientsCounter}})</div><div ng-if="isEditing.val || (allRecipients.to.length || !isEditing.val && (allRecipients.cc.length || allRecipients.bcc.length))" nxt-is-editing=isEditing nxt-email-input-plain nxt-name=composition-to class=composition-to nxt-basevalue=to ng-blur=update()></div><div class=composition-switches ng-if=isEditing.val><div ng-if=!isCCShown class="composition-show composition-show--cc link" ng-click=showCC(true)>DW</div><div ng-if=!isBCCShown class="composition-show composition-show--bcc link" ng-click=showBCC(true)>UDW</div></div><div ng-if="(isCCShown && isEditing.val) || (allRecipients.cc.length && !isEditing.val)" nxt-is-editing=isEditing nxt-email-input-plain nxt-name=composition-cc class=composition-cc nxt-basevalue=cc ng-blur=update()></div><div ng-if="(isBCCShown && isEditing.val) || (allRecipients.bcc.length && !isEditing.val)" nxt-is-editing=isEditing nxt-email-input-plain nxt-name=composition-bcc class=composition-bcc nxt-basevalue=bcc ng-blur=update()></div>'),a.put("o.iplsc.com/n/js/composition/views/failureBar.html",'<div class=message__info-bar ng-repeat="failure in ::deliveryReport.failures"><span class="icon icon-dialog-warning"></span><div class=message__info-bar__title><span ng-if=::deliveryReport.isDate>Wiadomość wysłana {{::deliveryReport.date}} o&nbsp;godzinie {{::deliveryReport.hour}} nie&nbsp;dotarła na&nbsp;adres(y):</span> <span ng-if=::!deliveryReport.isDate>Wiadomość nie dotarła na adres:</span> <span ng-if=::failure.addresses class=message__info-bar-failure__addresses ng-repeat="address in ::failure.addresses"><a class=message__info-bar__address ng-click="openComposition($event, address)" ng-href="{{\'mailto:\' + address}}">{{::address + \' \'}}</a></span></div><div class=message__info-bar__reason>{{::failure.reason}}</div><div class=message__info-bar__action ng-bind-html=::failure.suggestion></div>'),a.put("o.iplsc.com/n/js/composition/views/signature.html",'<div class=composition__signature-container ng-class="{\'composition__signature-container--selected\': selectedSignature}"><div ng-show="isEditingSignature && signatureAllow" class=composition__signature-add><textarea class=composition__signature-add__textarea placeholder="Z wyrazami szacunku - Jan Kowalski" ng-model=signatureText></textarea><div class=composition__signature-add__inputs><div nxt-input nxt-input-placeholder="Podaj nazwę" nxt-input-name=signatureName nxt-input-maxlength=50 ng-model=signatureName></div><div class="composition__signature-add__button composition__signature-add__button--save link" ng-click=saveSignature()>zapisz</div><div class="composition__signature-add__button composition__signature-add__button--cancel" ng-click=clearSignature()>anuluj</div></div></div><div ng-hide="isEditingSignature || !signatureAllow" class=composition__signature ng-class="{\'composition__signature--selected\': selectedSignature}" nxt-simple-dropdown><div class=composition__signature__selected nxt-simple-dropdown-activator><div ng-if=selectedSignature class=composition__signature__selected__text ng-bind=selectedSignature.value></div><div ng-if=!selectedSignature class=composition__signature__selected__empty>Brak podpisu - <span class=link ng-click=editSignature()>dodaj podpis</span></div></div><ul class=dropdown nxt-simple-dropdown-content><li class=dropdown__item ng-click=changeSignature()>Brak podpisu<li ng-repeat="s in signatures" ng-click=changeSignature(s) class=dropdown__item>{{s.name}}<li class="dropdown__item link" ng-click=editSignature() data-track-click-iwa=addSignatureClick>Dodaj podpis</ul><div ng-if="isFreeAccount && selectedSignature" class=composition__signature__autopromo>Profesjonaliści dbają o detale. Dołącz do nich. <a class=link ng-click=clickAutopromo() href={{::SIGNATURE_AUTOPROMO_BUSINNESS}} target=_blank>Rozszerz możliwości swojej poczty INTERIA »</a></div></div></div>'),a.put("o.iplsc.com/n/js/contact/views/contact-header.html",'<div class=dialog__icon><div nxt-avatar nxt-avatar-list=contact.avatar nxt-avatar-contact-email=::contact.email data-tooltip-stop-propagation></div></div><div class=dialog__title ng-bind-html="::contact.name | wbr"></div><div class="dialog__subtitle link" ng-bind=::contact.email></div><div class=dialog__actions><span class="icon icon-inbox" ng-click="createNewMessage(); close(); $event.preventDefault();" data-tooltip="Utwórz nową wiadomość" data-track-click=contactListClickIcon data-track-click-iwa=contactNewMessage></span> <span ng-if=!contact.isReadonly class="icon icon-edit" ng-click="editContact(); close(); $event.preventDefault();" data-tooltip=Edytuj data-track-click-iwa=contactEdit></span> <span nxt-dropdown nxt-dropdown-icon=dots nxt-dropdown-fixed=dropdownPosition><ul class=dropdown__list><li ng-if=isMobile class="dropdown__item dropdown__item--new-message" ng-click="createNewMessage(); close(); $event.preventDefault();" data-track-click=contactListClickIcon data-track-click-iwa=contactNewMessage>Napisz wiadomość<li ng-if=isMobile class="dropdown__item dropdown__item--edit" ng-click="editContact(); close(); $event.preventDefault();" data-track-click-iwa=contactEdit>Edytuj<li class=dropdown__item ng-click="showMailingHistory(); close(); $event.preventDefault();" data-track-click-iwa=contactHistory>Pokaż wiadomości<li class=dropdown__item ng-click="addNewFilter(); $event.preventDefault();">Filtruj wiadomości<li ng-if="!contact.isReadonly && !contact.isOnBlacklist" class=dropdown__item ng-click="addToBlacklist(); $event.preventDefault();">Zablokuj tę osobę<li ng-if="!contact.isReadonly && contact.isOnBlacklist" class=dropdown__item ng-click="removeFromBlacklist(); $event.preventDefault();">Usuń z zablokowanych<li class=dropdown__item ng-click=deleteContact()>Usuń</ul></span></div>'),a.put("o.iplsc.com/n/js/contact/views/contact.html",'<div ng-show=contact class=contact-container><div class=contact><div data-tooltip="Napisz wiadomość do tej osoby"><div ng-if=::isAvatarShow ng-click=newMessage(contact) nxt-avatar nxt-avatar-list=contact.avatar nxt-avatar-contact-email=::contact.email class="contact__avatar contact__avatar--filled"></div><div ng-if=!isAvatarShow class=contact__avatar__placeholder></div></div><div class=contact__info ng-click=newMessage(contact)><div class=contact__name ng-bind=::contact.name></div><div class=contact__email ng-bind=::contact.email></div></div><span class="contact__show__details icon icon-info" data-tooltip="Zobacz dane kontaktowe" data-track-click-iwa=contactShowContactDetails ng-click="openContactDetails(); $event.preventDefault();"></span></div></div>'),a.put("o.iplsc.com/n/js/contact/views/details.html",'<div ng-controller=ContactDetailsCtrl><div class=contact-details__sections><div ng-if=contact.emails.length class=contact-details__section><ul class=contact-details__list><li class=contact-details__item ng-repeat="email in contact.emails"><span class=contact-details__item__label ng-bind=::getEmailType(email)></span> <span class="contact-details__item__value link" ng-bind=::email.value ng-click="newMessage({\'email\': email.value}); $event.preventDefault();"></span></ul></div><div class=contact-details__section ng-if=contact.phones.length><ul class=contact-details__list><li class=contact-details__item ng-repeat="phone in contact.phones"><span class=contact-details__item__label ng-bind=::getPhoneType(phone)></span> <span class=contact-details__item__value ng-bind="::phone.value | number"></span></ul></div><div ng-if="groups && contact.groups.length" class="contact-details__section contact-details__item"><span class=contact-details__item__label>Grupy</span> <span class=contact-details__item__value ng-bind=::getContactGroups()></span></div><div class="contact-details__section contact-details__item" ng-if=contact.note.length><span class=contact-details__item__label>Notatka</span> <span class=contact-details__item__value ng-bind=contact.note></span></div></div></div>'),a.put("o.iplsc.com/n/js/contact/views/edit.html",'<div ng-controller=ContactEditCtrl><form novalidate name=contactForm ng-submit="contactForm.$valid && submit(); $event.preventDefault();" ng-show=showContent><div class=contacts-form__content><div class="contacts-form__content__section contacts-form__content__section--row"><div ng-if=::!isMobile nxt-avatar nxt-avatar-list=contact.avatar data-tooltip-stop-propagation></div><div nxt-input nxt-input-name=name nxt-input-type=text nxt-input-placeholder="Nazwa kontaktu" nxt-input-pattern=specialCharsPattern nxt-input-maxlength=32 nxt-input-error="contactForm.name.$dirty && contactForm.name.$error" nxt-input-error-message=::nameErrorMessage ng-model=contact.name autofocus required></div></div><div class=contacts-form__content__section><ul class=contacts-form__content__list><li class="contacts-form__content__list__item contacts-form__content__list-item--is-editable" ng-repeat="email in contact.emails"><div class="input-wrapper input-wrapper--with-select" ng-form name=contactEmailForm><label for=email_{{$index}} class="input-container input-container--select"><span class=ui-select-match ng-bind=getEmailType(email)></span><hr class=input-line></label><div nxt-input nxt-input-type=email nxt-input-name=email nxt-input-placeholder="Adres e-mail" nxt-input-pattern=emailPattern ng-model=contact.emails[$index].value nxt-input-error=contactEmailForm.email.$invalid nxt-input-error-message="\'Wpisz poprawny adres e-mail\'" id=email_{{$index}} required></div></div></ul><div ng-show="contact.emails.length < 3"><div class="input-wrapper input-wrapper--with-select"><div class="input-container input-container--select"><ul ui-select ng-model=contact.newEmail.type name=contact-email ng-click="selectClose($select, \'email\')"><li ui-select-match>{{$select.selected.name}}<li ui-select-choices repeat="type.id as type in EMAIL_TYPES"><span ng-bind=type.name></span></ul><hr class=input-line></div><div nxt-input nxt-input-type=email nxt-input-name=email nxt-input-placeholder="Adres e-mail" nxt-input-pattern=emailPattern nxt-input-error="contactForm.email.$dirty && contactForm.email.$invalid && contactForm.email.$touched" nxt-input-error-message="\'Wpisz poprawny adres e-mail\'" ng-model=contact.newEmail.value></div></div><a href=# class="link contacts-form__add-more" ng-show="contact.newEmail.type && contact.newEmail.value && contact.emails.length < 2" ng-click="addNewEmail(); $event.preventDefault();" data-track-click=contactAddNextEmail>+ Dodaj następny adres e-mail</a></div></div><div class=contacts-form__content__section ng-if="groups.length > 0"><div><div class="input-container input-container--select input-container--touched-line"><div nxt-dropdown nxt-dropdown-fixed=::dropdownPosition nxt-dropdown-select=true nxt-dropdown-text={{groupsPlaceholder}} nxt-dropdown-icon=arrow nxt-dropdown-placeholder=Grupy><ul class="dropdown__list dropdown__list--multiselect"><li class=dropdown__item ng-class="{\'dropdown__item--active\': isGroupAlreadySelected(group)}" ng-repeat="group in groups" ng-click=selectGroup(group) nxt-stop-click-propagation><span ng-bind=::group.name></span></ul></div><hr class=input-line></div></div></div><div class=contacts-form__content__section><ul class=contacts-form__content__list><li class=contacts-form__content__list__item ng-repeat="phone in contact.phones"><div class="input-wrapper input-wrapper--with-select" ng-form name=contactPhoneForm><label for=phone_{{$index}} class="input-container input-container--select"><span class=ui-select-match ng-bind=getPhoneType(phone)></span><hr class=input-line></label><div nxt-input nxt-input-type=tel nxt-input-name=phone nxt-input-placeholder="Numer telefonu" nxt-input-pattern=phonePattern nxt-input-error=contactPhoneForm.phone.$invalid nxt-input-error-message="\'Wpisz poprawny numer telefonu\'" ng-model=contact.phones[$index].value id=phone_{{$index}} required></div><span class="contacts-form__content__options icon icon-close" ng-click="deletePhone($index); $event.preventDefault();" data-track-click=contactDeletePhone></span></div></ul><div ng-show="contact.phones.length < 3"><div class="input-wrapper input-wrapper--with-select"><div class="input-container input-container--select"><ul ui-select ng-model=contact.newPhone.type name=contact-phone ng-click="selectClose($select, \'tel\')"><li ui-select-match>{{$select.selected.name}}<li ui-select-choices repeat="type.id as type in PHONE_TYPES"><span ng-bind=type.name></span></ul><hr class=input-line></div><div nxt-input nxt-input-type=tel nxt-input-name=phone nxt-input-placeholder="Numer telefonu" nxt-input-pattern=phonePattern nxt-input-error="contactForm.phone.$dirty && contactForm.phone.$invalid && contactForm.phone.$touched" nxt-input-error-message="\'Wpisz poprawny numer telefonu\'" ng-model=contact.newPhone.value></div></div><a href=# class="link contacts-form__add-more" ng-show="contact.newPhone.type >= 0 && contact.newPhone.value && contact.phones.length < 2" ng-click="addNewPhone(); $event.preventDefault();" data-track-click=contactAddNextPhone>+ Dodaj następny numer telefonu</a></div></div><div class=contacts-form__content__section><div nxt-input nxt-input-name=note nxt-input-type=textarea nxt-input-placeholder="Treść notatki" nxt-input-pattern=specialCharsPattern nxt-input-error="contactForm.note.$invalid && contactForm.note.$dirty" nxt-input-error-message="\'Notatka zawiera niedozwolone znaki\'" ng-model=contact.note></div></div><div class=dialog__buttons-container><button class=button type=submit ng-disabled=contactForm.$invalid data-track-click-iwa=contactActionAdd>Zapisz</button><button class="button button--cancel button--margin-left" ng-click="reset(); cancel(); $event.preventDefault();">Anuluj</button></div></div></form></div>'),a.put("o.iplsc.com/n/js/contact/views/group-add.html",'<div ng-controller=GroupAddCtrl><form novalidate name=groupAddForm ng-submit="groupAddForm.$valid && submit(); $event.preventDefault();"><div class=group-form><div class="group-form__name contacts-form__content contacts-form__content__section--row"><div ng-if=::!isMobile><div class=avatar><div class="avatar__content avatar__content--group"></div></div></div><div nxt-input nxt-input-name=name nxt-input-placeholder="Nazwa grupy" nxt-input-pattern=specialCharsPattern nxt-input-maxlength=32 nxt-input-error="groupAddForm.name.$invalid && errors.name" nxt-input-error-message=errors.name ng-model=group.name autofocus required></div></div><ul class=contact__list><li class=contact__list__item ng-class="{\n                        \'contact__list__item--selected\': isContactSelected(contact.id)\n                    }" ng-repeat="contact in contacts | limitTo: currentPackage * 25" ng-attr-id=::contact.id><div ng-if="contact.type !== CONTACT_TYPE_SPECIAL" class=contact__list__item__select nxt-stop-click-propagation ng-click=toggleContact(contact.id)><div nxt-contact nxt-contact-data=contact></div></div></ul><div class=dialog__buttons-container><button class=button type=submit ng-disabled=groupAddForm.$invalid data-track-click-iwa=contactAddGroup>Zapisz</button><button class="button button--cancel button--margin-left" ng-click="reset(); cancel(); $event.preventDefault();">Anuluj</button></div></div></form></div>'),a.put("o.iplsc.com/n/js/contact/views/group-details.html",'<div ng-controller=GroupDetailsCtrl><div class=contact-details__section><ul class=contact__list><li class="contact__list__item contact__list__item--group" ng-repeat="contact in contacts" ng-attr-id=contact.id><div nxt-stop-click-propagation><div nxt-contact nxt-contact-data=contact></div></div><div nxt-dropdown nxt-dropdown-icon=dots nxt-dropdown-fixed=::dropdownPosition><ul class=dropdown__list><li class=dropdown__item ng-click="removeContactFromGroup(contact); $event.preventDefault();">Usuń z&nbsp;grupy</ul></div></ul></div></div>'),a.put("o.iplsc.com/n/js/contact/views/group-header.html",'<div class=dialog__icon><div class=avatar><div class="avatar__content avatar__content--group"></div></div></div><div class=dialog__title ng-bind=::group.name></div><div class=dialog__subtitle ng-bind=subtitle></div><div class=dialog__actions><span class="icon icon-inbox" data-tooltip="Napisz wiadomość do grupy kontaktów" ng-click="newMessageForGroup(); close(); $event.preventDefault();"></span> <span ng-if=::allowedGroupActions.edit class="icon icon-edit" ng-click="editGroup(); close(); $event.preventDefault();" data-tooltip=Edytuj></span> <span ng-if=::allowedGroupActions.delete nxt-dropdown nxt-dropdown-icon=dots nxt-dropdown-fixed=::dropdownHeaderPosition><ul class=dropdown__list><li ng-if=isMobile class="dropdown__item dropdown__item--new-message" ng-click="newMessageForGroup(); close(); $event.preventDefault();">Napisz<li ng-if=isMobile class="dropdown__item dropdown__item--edit" ng-click="editGroup(); close(); $event.preventDefault();">Edytuj<li class=dropdown__item ng-click="deleteGroup(); $event.preventDefault();">Usuń grupę</ul></span></div>'),a.put("o.iplsc.com/n/js/contact/views/group.html",'<div class=contact ng-click="newMessageForGroup(); $event.stopPropagation()"><div class="contact__avatar contact__avatar--filled"><div class=avatar><div class="avatar__content avatar__content--group"></div></div></div><div class=contact__info><div class=contact__name ng-bind=group.name></div><div class=contact__email ng-bind=subtitle></div></div><span class="contact__show__details icon icon-info" data-tooltip="Zobacz dane grupy" ng-click="openGroupDetails(); $event.stopPropagation()"></span></div>'),a.put("o.iplsc.com/n/js/contact/views/main.html",'<div class="settings contact-container"><div class=sidebar__title ng-if=::!isMobile>Kontakty<div class=sidebar__title__icons><span class="icon icon-contact-add2" ng-click=createContact(); data-tooltip="Dodaj kontakt" data-track-click=contactsMainToolbarAddClick data-track-click-iwa=contactActionAdd></span> <span ng-if=::isAddGroupAllowed class="icon icon-contact-add-group" ng-click=createGroup(); data-tooltip="Dodaj grupę"></span> <span ng-if=$parent.$parent.openPanel class="sidebar-close icon icon-close" ng-click=$parent.$parent.$parent.closePanel(); data-track-click-iwa=contactHideList></span></div></div><div ng-if=::isMobile><div class=navigation-header><div class="icon icon-hamburger navigation-header__hamburger" ng-class="{\'navigation-header__hamburger--with-counter\': unseenMessageCount}" ng-click="close(); $event.stopPropagation();"><div nxt-navigation-counter={{unseenMessageCount}} nxt-navigation-counter-sum></div></div><span class=navigation-header__title>Kontakty</span><div class=sidebar__title__icons><span class="icon icon-contact-add2" ng-click=createContact(); data-tooltip="Dodaj kontakt" data-track-click=contactsMainToolbarAddClick></span> <span ng-if=::isAddGroupAllowed class="icon icon-contact-add-group" ng-click=createGroup(); data-tooltip="Dodaj grupę"></span></div></div></div><div class=contact-container__content><div ng-if=::isMobile class=input-container><input class=input type=search name=contact_search id=contact-search ng-model=data.search data-track-change=useSearcherContact ng-change=searchChange()><hr class=input-line><span class="icon icon-search"></span><label ng-if=!data.search class="input-placeholder input-placeholder--header" for=contact-search>Szukaj</label><span ng-if="data.search.length > 0" class="icon icon-close" ng-click=clearSearch() data-tooltip="Wyczyść szukaną frazę" data-track-click=searcherContactClose></span></div><div ng-if=::isPc class=search-input-container><div class=input-container><input class=input type=search name=contact_search id=contact-search ng-model-options="{ debounce: 100 }" ng-model=data.search data-track-change=useSearcherContact><hr class=input-line><span class="icon icon-search"></span><label ng-if=!data.search class="input-placeholder input-placeholder--header" for=contact-search>Szukaj kontaktu</label><span ng-if="data.search.length > 0" class="icon icon-close" ng-click=clearSearch() data-tooltip="Wyczyść szukaną frazę" data-track-click=searcherContactClose></span></div></div></div><div class=section__scroll nxt-scroll-detector=contact-list:scroll><ul class=contact__list ng-class="{\n                \'contact-list--loading\': contactIsLoading\n            }"><li class=contact__list__item ng-repeat="listItem in list | filter: data.search | limitTo: currentPackage * 25" ng-attr-id=::listItem.id><div ng-if="listItem.itemType === LIST_ITEM_TYPE.contact" nxt-contact nxt-contact-data=listItem nxt-contact-is-group-edited=isGroupEdited nxt-contact-selected-group=selectedGroup nxt-contact-is-mode-select=isModeSelect></div><div ng-if="listItem.itemType === LIST_ITEM_TYPE.group" nxt-group nxt-group-data=listItem nxt-group-contacts=contacts></div></ul></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog.html","<div ng-if=\"isBackgroundCloseable || isModal\" ng-click=\"isBackgroundCloseable ? closeCallback($event) : ''\" class=dialog__closeable-layer></div><div class=dialog-wrapper ng-click=\"isBackgroundCloseable ? closeCallback($event) : ''\" ng-class=\"{'dialog-wrapper--is-maximizing': isChangingSize}\"><div class=dialog-container ng-class=\"{\n            'dialog-container--no-icon': !icon,\n            'dialog--with-sticky-header': isDialogStickyHeader,\n            'dialog--always-sticky-header': isAlwaysDialogStickyHeader,\n            'dialog--with-scroll': isDialogScroll,\n            'dialog--with-scroll-animate': isDialogScrollAnimate,\n            'dialog--with-scroll-bottom': isDialogScrollBottom,\n            'dialog--with-mobile-scroll': isMobileDialogScroll\n         }\" nxt-dialog-scroll={{::scrollType}}><header class=dialog__header ng-include=::templateHeader></header><div ng-if=::isClosable class=\"dialog__close icon icon-close\" ng-click=close()></div><div class=dialog__scroll nxt-scroll-detector={{::scrollDetector}}><div class=dialog__scroll__header ng-include=::templateHeader></div><div ng-include=template></div></div><div class=dialog-footer-placeholder></div></div></div>"),a.put("o.iplsc.com/n/js/dialog/views/dialogList.html",'<div nxt-dialog class="dialog loading {{d.additionalClasses}}" ng-repeat="d in dialogs track by d.id" nxt-movable={{d.isMovable}} nxt-auto-center-vertically nxt-title={{d.title}} nxt-id={{d.id}} nxt-template={{d.template}} nxt-params=d></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_adult_permission.html",'<div ng-controller=AdultPermissionCtrl><p class=dialog__content>Nie masz wyrażonej zgody na otrzymywanie materiałów dla osób pełnoletnich (napoje alkoholowe lub gry hazardowe). Chcemy mieć pewność, że wysyłamy wiadomości dopasowane do Twoich potrzeb, dlatego zależy nam na Twoim wyborze. Ilość informacji handlowych nie ulegnie zmianie niezależnie od tego, czy udzielisz zgody.<div class="dialog__buttons-container dialog__buttons-container--with-margin"><button class=button ng-click=save(FORM_STATES.discard);>Nie wyrażam zgody</button> <button class="button button--margin-left" ng-click=save(FORM_STATES.accept);>Wyrażam zgodę</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_app_promo.html",'<div class=app-promo-plywak__container ng-class="{\'app-promo-plywak--version2\': params.additionalData.version == 2}"><div class=app-promo-plywak__header><span ng-if="params.additionalData.version == 1">Korzystaj z Poczty {{ isInt ? \'INT\' : \'Interia\' }} w… </span><span ng-if="params.additionalData.version == 2">Boisz się, że przegapisz e-mail? </span><span ng-if="params.additionalData.version == 3">Ciągłe logowanie do poczty Cię frustruje? W darmowej aplikacji, wystarczy jedno kliknięcie, żeby sprawdzić wiadomości. </span><span ng-if="params.additionalData.version == 4">Znowu przegapiłeś wiadomość? Darmowa aplikacja powiadomi Cię o&nbsp;ważnych&nbsp;mailach.</span><div class="icon icon-close" ng-if="params.additionalData.version == 1 || params.additionalData.version == 2" ng-click="close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.close)"></div></div><div class=app-promo-plywak__tooltip ng-if="params.additionalData.version == 2"><p class=app-promo-plywak__tooltip-title><strong>Przeglądarka nie da Ci znać o nowej wiadomości, ale aplikacja – tak!</strong> Włącz powiadomienia i bądź zawsze na bieżąco.<hr class=app-promo-plywak__tooltip-separator><p class=app-promo-plywak__tooltip-subtitle><strong>Kontynuuj w</strong></div><div class=app-promo-plywak__tooltip ng-if="params.additionalData.version == 3 || params.additionalData.version == 4"><p class=app-promo-plywak__tooltip-subtitle><strong>Kontynuuj w</strong></div><div class=app-promo-plywak__content><div class=app-promo-plywak__item><div class=app-promo-plywak__img-container><img ng-src="{{::staticUrl + params.additionalData.appImageUrl}}" alt="Ikonka aplikacji pocztowej" height=44 width=44 class=app-promo-plywak__img></div>Aplikacji <button class=button ng-click="openNewTab(params.additionalData.appUrl);close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.action)">Otwórz</button></div><div class=app-promo-plywak__item><div class=app-promo-plywak__img-container><img ng-src="{{::staticUrl + \'/public/images/appPromo/browser-icon.svg\'}}" alt="Ikonka przeglądarki" height=20 width=20 class="app-promo-plywak__img app-promo-plywak__img--browser"></div>Przeglądarce <button class="button button--cancel" ng-click="close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.continue)">Kontynuuj</button></div></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_birthday_rodo.html",'<div class=dialog-confirm><form name=birthday-rodo><p class=spec-title>Prawidłowo uzupełnione dane ułatwią Ci odzyskanie dostępu do konta gdy pozostałe opcje zawiodą<p class=spec-title-description>Uzupełnij pełną datę urodzenia:<div class=dialog-brithday-rodo><input class=input ng-model=birthday.day placeholder=Dzień><div class=month><div class=option-wrapper ng-click="folderMode = \'existing\'" ng-class="{disabled: folderMode === \'new\'}"><ul ui-select ng-model=params.additionalData.month><li ui-select-match class=ui-select-match--dialog ng-model=birthday.month placeholder=Miesiąc>{{$select.selected.value}}<li ui-select-choices repeat="month in params.additionalData.months" data-id=$index ng-model=birthday.month><span ng-bind=month.value></span></ul></div></div><input ng-model=birthday.year placeholder={{params.additionalData.userAge}} class="input placeholder-grey"></div><button class="button button-center" ng-click=params.additionalData.sendDate(birthday)>Zapisz i przejdź do poczty</button></form></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_business_account_promotion_261.html",'<div class=dialog__content><a class="button button--go-board" ng-click="success(); close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.goBoard)" ng-href={{::params.additionalData.destUrl}} target=_blank></a><div class="button button--close" ng-click="close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.close);$event.stopPropagation()"></div><a class="button button--go" ng-click="success(); close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.go)" ng-href={{::params.additionalData.destUrl}} target=_blank></a></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_business_activation_plan_259.html",'<div class=business-activation-plan-259><h1 class=business-activation-plan-259__title>Aktywuj pełną moc<br>Interia PocztaPRO</h1><p class=business-activation-plan-259__message>Zarejestruj darmową domenę w każdej chwili i<br>wykorzystaj pełnię możliwości<br>Interia PocztaPRO, czyli:<ul class=business-activation-plan-259__list><li>adres e-mail we własnej domenie<li>profesjonalną strona www</ul><div class=business-activation-plan-259__buttons-group><a class="button button--go" ng-click="pushStatIWACode(\'infoboard259Go\'); cancel();" ng-href={{::urlToActivationPlanDomain}} target=_blank>Zarejestruj domenę </a><button class="button button--close button--cancel" ng-click="pushStatIWACode(\'infoboard259Cancel\'); cancel();">Anuluj</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_business_website_complete.html",'<div ng-controller=BusinessWebsiteCompleteCtrl><div class=dialog__content>Już tak niewiele brakuje,<br>aby Twoja strona istniała w sieci.</div><div class=dialog__buttons-container><button class=button ng-click=fillData()>Uzupełnij dane</button><button class="button button--cancel button--margin-left" ng-click="cancel(); pushStat(params.additionalData.stat.type, params.additionalData.stat.close, \'229\')">Później</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_captcha_verify.html","<div ng-controller=VerifyCaptchaCtrl><div class=dialog__content>Wykryliśmy nietypowy ruch pochodzący z&nbsp;Twojej sieci komputerowej.<br>Przepisz kod z obrazka i&nbsp;potwierdź, że&nbsp;to Ty, aby kontynuować korzystanie z&nbsp;poczty.<div nxt-captcha></div></div><div class=dialog__buttons-container><button class=button ng-click=success()>Zapisz</button></div></div>"),a.put("o.iplsc.com/n/js/dialog/views/dialog_composition.html","<div nxt-composition nxt-dialogid={{id}}></div>"),a.put("o.iplsc.com/n/js/dialog/views/dialog_composition_mobile.html","<div nxt-composition=simplified nxt-dialogid={{id}} class=dialog-container></div>"),a.put("o.iplsc.com/n/js/dialog/views/dialog_confirm.html",'<div class=dialog-confirm><div class=dialog__content ng-if=::params.message ng-bind-html=::params.message></div><div class=dialog__buttons-container><button class=button ng-click=success();>{{::params.confirm}}</button><button class="button button--cancel button--margin-left" ng-click=cancel()>{{::params.cancel}}</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_default.html",""),a.put("o.iplsc.com/n/js/dialog/views/dialog_delete_mailings.html",'<div><div nxt-bind-html-compile=params.message class=dialog__content></div><div class=dialog__buttons-container><div class=button ng-click="success(); close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.go)" ng-href={{::params.additionalData.destUrl}}>Usuń</div><div class="button button--cancel button--margin-left" ng-click="close(); cancel(); pushStat(params.additionalData.stat.type, params.additionalData.stat.closeBtn);$event.stopPropagation();">Anuluj</div></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_enable_poczta_pro_theme.html",'<div class=poczta-pro-enable-theme__wrapper ng-controller=PocztaProEnableThemeCtrl><div ng-if=::isClosable class="dialog__close icon icon-close" ng-click=close()></div><div class=poczta-pro-enable-theme__content><div class=poczta-pro-enable-theme__header><img ng-src="{{::staticUrl + \'/public/images/poczta-pro/logo-poczta-pro.svg\'}}" width=137 height=16 alt="Logo PocztaPRO" class=poczta-pro-enable-theme__header-logo><div class=poczta-pro-enable-theme__header-title>Dedykowana skórka PocztaPRO</div></div><div class=poczta-pro-enable-theme__copy><div class=poczta-pro-enable-theme__copy-text-title>Włącz nową skórkę i ciesz się odświeżonym interfejsem! W każdej chwili możesz wrócić do poprzedniej skórki w ustawieniach kolorów Twojej poczty.</div><strong class=poczta-pro-enable-theme__copy-text-title--bold>Sprawdź teraz i odkryj nową jakość pracy z PocztaPRO! 🚀</strong></div></div><div class=poczta-pro-enable-theme__buttons><a class="button button--go" ng-click=success();>Aktywuj skórkę PocztaPRO </a><button class="button button--link button--margin-top" ng-click=close();>Dziękuję, innym razem</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_expired_info.html",'<div ng-controller=ExpiredInfoCtrl><div class="icon icon-close" ng-click="close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.close)"></div><div class=dialog__content>Zgodnie z <span class=link ng-click="goToRegulation(); pushStat(params.additionalData.stat.type, params.additionalData.stat.regulation)">regulaminem poczty</span> ({{::regulations}}), INTERIA.PL zastrzega sobie prawo do usuwania korespondencji przechowywanej na koncie Użytkownika, jeśli Użytkownik nie logował się do konta bezpłatnego przez okres dłuższy niż 366 dni (licząc od daty ostatniego logowania).</div><div class=dialog__buttons-container><button class="button button--cancel" ng-click="success(); pushStat(params.additionalData.stat.type, params.additionalData.stat.go)">Przejdź do poczty</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_expired_info_int.html",'<div class=dialog-info ng-controller=ExpiredInfoCtrl><div class=dialog__content>Zgodnie z <a class=link target=_blank href={{::regulationsUrl}}>regulaminem poczty INT</a> ({{::regulations}}), INTERIA.PL zastrzega sobie prawo do usuwania korespondencji, która jest przechowywana na Koncie, jeżeli Użytkownik konta pocztowego nie logował się do konta pocztowego przez okres dłuższy niż 366 dni (licząc od daty ostatniego logowania), bez możliwości ich ponownego odtworzenia.</div><div class=dialog__buttons-container><button class="button button--cancel" ng-click=success();>Przejdź do poczty</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_facebook.html",'<div><div class="boardButton boardButton--close" ng-click="close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.close);$event.stopPropagation();"></div><iframe ng-src={{urls.FACEBOOK_PLUGIN}} width=400 height=80 style=border:none;overflow:hidden scrolling=no frameborder=0 allowtransparency=true></iframe></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_header.html",'<div ng-if=icon class="dialog__icon icon icon-{{icon}}"></div><div ng-if=title class=dialog__title ng-bind-html=title></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_info.html","<div><div class=dialog__content ng-bind-html=params.message></div><div class=dialog__buttons-container><button class=button ng-click=success();>{{params.confirm}}</button></div></div>"),a.put("o.iplsc.com/n/js/dialog/views/dialog_info_board.html",'<div class=dialog__content><div class="button button--close" ng-click="close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.close);$event.stopPropagation();"></div><a class="button button--go" ng-click="success(); close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.go)" ng-href={{::params.additionalData.destUrl}} target="{{params.additionalData.isInNewWindow ? \'_blank\' : \'_self\'}}"></a></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_mailing_alias.html","<div class=dialog-info><div class=dialog-mailing-alias-close ng-click=close()></div><p class=dialog-message>Od teraz <b>reklamy z kont zewnętrznych</b> będą przenoszone do specjalnego folderu Mailingi w sekcji Moje Foldery.<br><br>Jeżeli chcesz wyłączyć ten folder możesz to zrobić w zakładce Filtry w Ustawieniach.<div class=dialog__buttons-container><button class=button ng-click=success();>Przejdź do poczty</button></div></div>"),a.put("o.iplsc.com/n/js/dialog/views/dialog_mobile_calendar.html","<div class=dialog-mobile-calendar ng-click=$event.preventDefault() nxt-mobile-calendar={{params.additionalData.inputName}} nxt-mobile-calendar-date={{params.additionalData.date}} nxt-mobile-calendar-min={{params.additionalData.minDate}} nxt-mobile-calendar-max={{params.additionalData.maxDate}} nxt-mobile-calendar-birthday={{params.additionalData.calendarRodo}} nxt-mobile-calendar-birthday-year={{params.additionalData.year}} nxt-stop-touch-propagation-browser=iemobile></div>"),a.put("o.iplsc.com/n/js/dialog/views/dialog_old_app_info.html","Drogi użytkowniku, informujemy, że ze względów bezpieczeństwa wkrótce nie będzie możliwe logowanie do usługi za pomocą obecnie zainstalowanej wersji aplikacji. Prosimy o jej zaktualizowanie lub zalogowanie przez stronę <a class=link href=https://poczta.interia.pl target=_blank rel=noopener>poczta.interia.pl</a>.<br>Zmiana nie spowoduje utraty dostępu do konta. Wszystkie Twoje dane na koncie są bezpieczne.<br>W razie jakichkolwiek wątpliwości bądź pytań zachęcamy do kontaktu z Biurem Obsługi Klienta (<a class=link href=mailto:bok@firma.interia.pl>bok@firma.interia.pl</a>)<br><a class=old-app-info__button href={{::params.additionalData.href}} target=_blank rel=noopener ng-click=success()><img class=old-app-info__button__img ng-src=\"{{::staticUrl + '/public/images/appPromo/' + params.additionalData.imgName}}\" alt={{::params.additionalData.imgAlt}}> </a>"),a.put("o.iplsc.com/n/js/dialog/views/dialog_poczta_pro_extension.html",'<div ng-controller=BusinessExtensionCtrl class=poczta-pro-promotion__wrapper><div class=poczta-pro-promotion__content><div class=poczta-pro-promotion__header><img ng-src="{{::staticUrl + \'/public/images/poczta-pro/logo-poczta-pro.svg\'}}" width=137 height=16 alt="Logo PocztaPRO" class=poczta-pro-promotion__header-logo><div class=poczta-pro-promotion__header-title>PocztaPRO wygasła <span class=poczta-pro-promotion__header-title--date>{{::expiryDate}}</span></div></div><div class=poczta-pro-promotion__copy><div class=poczta-pro-promotion__copy-text-title>Możesz korzystać z darmowej Poczty Interia. Zachowaj swoją domenę i stronę www.</div></div></div><div class=poczta-pro-promotion__buttons><a class="button button--go" ng-href={{params.additionalData.url}} ng-click="success();pushStat(params.additionalData.stat.type, params.additionalData.stat.go)" target=_blank>Przedłuż PocztaPRO </a><button class="button button--link button--margin-top" ng-click="close();pushStat(params.additionalData.stat.type, params.additionalData.stat.close)">Dziękuję, innym razem</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_poczta_pro_promotion.html",'<div class=poczta-pro-promotion__wrapper><div class=poczta-pro-promotion__content><div class=poczta-pro-promotion__header><img ng-src="{{::staticUrl + \'/public/images/poczta-pro/logo-poczta-pro.svg\'}}" width=137 height=16 alt="Logo PocztaPRO" class=poczta-pro-promotion__header-logo><div class=poczta-pro-promotion__header-title>Cześć!</div></div><div class=poczta-pro-promotion__copy><div class=poczta-pro-promotion__copy-text-title>Czy wiesz, że Twoja Poczta Interia może więcej?<br>Odkryj jej pełny potencjał!</div><ul class=promotion-reasons-list><li class=promotion-reasons-list__item><i class="icon icon-checkmark promotion-reasons-list__item-icon"></i><p class=promotion-reasons-list__item-text><strong>koniec z reklamami</strong><li class=promotion-reasons-list__item><i class="icon icon-checkmark promotion-reasons-list__item-icon"></i><p class=promotion-reasons-list__item-text>profesjonalna <strong>domena</strong> i 5 kont e-mail<li class=promotion-reasons-list__item><i class="icon icon-checkmark promotion-reasons-list__item-icon"></i><p class=promotion-reasons-list__item-text>dedykowana <strong>infolinia</strong><li class=promotion-reasons-list__item><i class="icon icon-checkmark promotion-reasons-list__item-icon"></i><p class=promotion-reasons-list__item-text>lepsze parametry</ul><div class=poczta-pro-promotion__copy-text-subtitle>A to wszystko <span class=bold>w jednej usłudze</span><br>bez zbędnych komplikacji! 🚀</div></div></div><div class=poczta-pro-promotion__buttons><a class="button button--go" ng-href={{params.additionalData.url}} ng-click="success();pushStat(params.additionalData.stat.type, params.additionalData.stat.go)" target=_blank>Zobacz szczegóły </a><button class="button button--link button--margin-top" ng-click="close();pushStat(params.additionalData.stat.type, params.additionalData.stat.close)">Dziękuję, innym razem</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_poczta_pro_rebranding_info.html",'<div class=poczta-pro-promotion__wrapper><div class=poczta-pro-promotion__content><div class=poczta-pro-promotion__header><img ng-src="{{::staticUrl + \'/public/images/poczta-pro/logo-poczta-pro.svg\'}}" width=137 height=16 alt="Logo PocztaPRO" class=poczta-pro-promotion__header-logo><div class=poczta-pro-promotion__header-title>Mamy dobrą wiadomość!</div></div><div class=poczta-pro-promotion__copy><div class=poczta-pro-promotion__copy-text-title>W dniu 2 kwietnia 2025 roku Pakiet dla firm zmieni&nbsp;się w&nbsp;usługę PocztaPRO i&nbsp;stanie&nbsp;się dla&nbsp;Ciebie jeszcze bardziej przyjazny oraz&nbsp;funkcjonalny.</div><div class="poczta-pro-promotion__copy-text-title poczta-pro-promotion__copy-text-title--bold">Co nowego zyskujesz?</div><ul class=promotion-reasons-list><li class=promotion-reasons-list__item><i class="icon icon-checkmark promotion-reasons-list__item-icon"></i><p class=promotion-reasons-list__item-text>profesjonalna pomoc - <b>dedykowana infolinia</b><li class=promotion-reasons-list__item><i class="icon icon-checkmark promotion-reasons-list__item-icon"></i><p class=promotion-reasons-list__item-text>więcej możliwości - <b>15&nbsp;GB transferu danych</b><li class=promotion-reasons-list__item><i class="icon icon-checkmark promotion-reasons-list__item-icon"></i><p class=promotion-reasons-list__item-text>szybkie i łatwe przedłużenia usługi</ul><div class=poczta-pro-promotion__copy-text-subtitle>Dziękujemy, że jesteś z nami!<br>Zespół Interia Poczta</div></div></div><div class=poczta-pro-promotion__buttons><button class="button button--go" ng-click=success();>Jasne, rozumiem</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_pop_trash.html",'<div ng-controller=PopTrashCtrl><div class="icon icon-close" ng-click="close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.close)"></div><div class="dialog__content dialog__content--with-bulb"><span class="icon icon-dialog-bulb"></span><div class=dialog__content__triangle></div><div>W konfiguracji klienta pocztowego (np. Outlook lub Thunderbird) nie zaznaczyłeś opcji "Pozostaw wiadomości na serwerze". Aby uchronić Cię przed przypadkową utratą maili, zamiast usuwać je definitywnie przenieśliśmy je do kosza.<div class="dialog__content dialog__content--checkbox-container dialog__form"><input id=not_inform class=checkbox type=checkbox name=not_inform ng-true-value=1 ng-false-value=0 ng-model=notInform><label class=checkbox-label for=not_inform>Nie informuj mnie więcej</label></div></div></div><div class="dialog__buttons-container dialog__buttons-container--with-margin"><button class=button ng-click=success()>Przywróć <span ng-if=::!isMobile>wiadomości</span></button> <button class="button button--cancel button--margin-left" ng-click=cancel()>Zamknij</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_premium.html",'<div ng-controller=PremiumAccountExpireCtrl class=dialog__content><div class=desc>Nie zwlekaj, przedłuż jej ważność już dziś i zapomnij o mailingach.</div><div class=dialog__buttons-container><a class=button ng-click="success(); close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.go)" ng-href={{::params.additionalData.destUrl}} target="{{params.additionalData.isInNewWindow ? \'_blank\' : \'_self\'}}" ng-bind=::params.additionalData.confirm></a> <button class="button button--cancel button--margin-left" ng-click=cancel()>Anuluj</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_premium_257.html",'<div class=dialog__content><a class="button button--go-board" ng-click="success(); close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.goBoard)" ng-href={{::params.additionalData.destUrl}} target=_blank></a><div class="button button--close" ng-click="close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.close);$event.stopPropagation()"></div><a class="button button--go" ng-click="success(); close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.go)" ng-href={{::params.additionalData.destUrl}} target=_blank></a></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_premium_promotion.html",'<div><div class=dialog__content ng-bind-html=params.message></div><div class=dialog__buttons-container><a class=button ng-click="success(); close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.go)" ng-href={{::params.additionalData.destUrl}} target="{{::params.additionalData.isInNewWindow ? \'_blank\' : \'_self\'}}" ng-bind=::params.additionalData.acceptButtonText></a><button class="button button--cancel button--margin-left" ng-click="close(); cancel(); pushStat(params.additionalData.stat.type, params.additionalData.stat.closeBtn);$event.stopPropagation();" ng-bind=::params.additionalData.cancelButtonText></button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_premium_promotion_discount_code.html","<div><div class=dialog__content ng-bind-html=params.message></div><div class=dialog__buttons-container><a class=button ng-click=\"success(); close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.go)\" ng-href={{::params.additionalData.destUrl}} target=\"{{::params.additionalData.isInNewWindow ? '_blank' : '_self'}}\" ng-bind=::params.additionalData.acceptButtonText></a></div></div>"),a.put("o.iplsc.com/n/js/dialog/views/dialog_profiling_autopromo.html",'<div class=dialog__content>Udostępniamy aż 6 nowych folderów:<br><span class=hightlight>Zakupy, Praca, Finanse, Nauka, Rozrywka, Zdrowie.</span></div><div class="dialog__content dialog__content--with-bulb"><span class="icon icon-dialog-bulb"></span><div class=dialog__content__triangle></div><span class=hightlight>Korzyści:</span><div class=dialog__content__list-item>maile posegregowane w specjalnych folderach (decydujesz, czy maile trafiają tylko do nowego folderu, czy dodatkowo chcesz je widzieć również w Odebranych);</div><div class=dialog__content__list-item>obsługa e-recept oraz e-skierowań (folder Zdrowie)*;</div><div class=dialog__content__list-item>możliwość wybierania nadawców przypisanych do folderów.</div></div><div class="dialog__content dialog__content--small">* <a href=https://pomoc.poczta.interia.pl/news-jak-wlaczyc-foldery-profilowane,nId,5665310 class=link target=_blank>Aby otrzymywać e-recepty aktywuj powiadomienia email w&nbsp;swoim profilu w&nbsp;Internetowym Koncie Pacjenta.</a></div><div class=dialog__buttons-container><button class=button ng-click="success(); pushStat(params.additionalData.stat.type, params.additionalData.stat.go)">Ok, rozumiem</button></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_push_prompt_confirm.html",'<div class="dialog__content dialog__content--with-bulb"><span class="icon icon-dialog-bulb"></span><div class=dialog__content__triangle></div><div class=dialog__content__list-item>Poinformujemy Cię o nowych wiadomościach</div><div class=dialog__content__list-item>Sam/a decydujesz z jakich folderów chcesz otrzymywać powiadomienia</div><div class=dialog__content__list-item>Nie wysyłamy powiadomień dla maili reklamowych od Interii i folderu SPAM</div></div><br><div class=dialog__content>Kliknij <span class=hightlight>Zezwalaj/Odbieraj</span>, aby otrzymywać powiadomienia Push. Jeśli nie chcesz otrzymywać powiadomień, kliknij <span class=hightlight>Blokuj</span>.</div><div class=dialog__buttons-container><a class=button ng-click="success(); pushStat(params.additionalData.stat.type, params.additionalData.stat.go)" target=_blank ng-href={{::params.additionalData.url}}>Dowiedz się więcej</a></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_recovery_options.html",'<form ng-controller=RecoveryOptionsCtrl name=specurityForm ng-submit=submit()><div class=dialog__content>Uzupełnij poniższe dane, aby szybko odzyskać dostęp do&nbsp;poczty w&nbsp;sytuacji, gdy&nbsp;zapomnisz hasła.</div><div class=dialog__form><div nxt-input nxt-input-placeholder="Numer telefonu" nxt-input-name=tel ng-model=tel ng-change="onFieldChange(\'Phone\')" nxt-input-pattern=phonePattern nxt-input-error="specurityForm.tel.$invalid && specurityForm.tel.$dirty && specurityForm.tel.$touched" nxt-input-error-message="\'Błędny format telefonu\'" autofocus></div><div nxt-input nxt-input-placeholder="Alternatywny adres e-mail" nxt-input-name=mail ng-model=mail ng-change="onFieldChange(\'Email\')" nxt-input-pattern=emailPattern nxt-input-error="specurityForm.mail.$invalid && specurityForm.mail.$dirty && specurityForm.mail.$touched" nxt-input-error-message="\'Błędny format adresu e-mail\'"></div></div><div class=dialog__buttons-container><button ng-disabled="specurityForm.$invalid || validate()" class=button>Zapisz{{::!isMobile ? \' i przejdź do poczty\' : \'\'}}</button><button ng-if=!isBlocking class="button button--cancel button--margin-left" ng-click=cancel();>Później</button></div></form>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_remind_expired_poczta_pro.html",'<div class=poczta-pro-promotion__wrapper ng-controller=BusinessAccountExpiredCtrl><div class=poczta-pro-promotion__content><div class=poczta-pro-promotion__header><img ng-src="{{::staticUrl + \'/public/images/poczta-pro/logo-poczta-pro.svg\'}}" width=137 height=16 alt="Logo PocztaPRO" class=poczta-pro-promotion__header-logo><div class=poczta-pro-promotion__header-title>PocztaPRO wkrótce wygaśnie!</div></div><div class=poczta-pro-promotion__copy><div class=poczta-pro-promotion__copy-text-title>Jeśli masz zarejestrowaną domenę, jej <strong>nieprzedłużenie oznacza utratę</strong> strony www, dodatkowych adresów e-mail i profesjonalnego wizerunku.</div><ul class=promotion-reasons-list><li class=promotion-reasons-list__item><i class="icon icon-checkmark promotion-reasons-list__item-icon"></i><p class=promotion-reasons-list__item-text>bez przerw w działaniu<li class=promotion-reasons-list__item><i class="icon icon-checkmark promotion-reasons-list__item-icon"></i><p class=promotion-reasons-list__item-text>bez utraty danych<li class=promotion-reasons-list__item><i class="icon icon-checkmark promotion-reasons-list__item-icon"></i><p class=promotion-reasons-list__item-text>bez dodatkowego stresu</ul></div></div><div class=poczta-pro-promotion__buttons><a class="button button--go" ng-click=success();>Przedłuż PocztaPRO </a><button class="button button--link button--margin-top" ng-click=close();>Dziękuję, innym razem</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_remove_message_from_view.html",'<div><div class=dialog__content><div>Przeniesienie do kosza, spowoduje, że nie będą już widoczne w wybranych folderach.</div><div class="dialog__content dialog__form"><div class="dialog__content dialog__content--checkbox-container"><input id=view-infoboard-not-show class=checkbox type=checkbox name=showInbox ng-true-value=1 ng-false-value=0 ng-model=params.additionalData.notShow><label for=view-infoboard-not-show class=checkbox-label>Nie pokazuj więcej tej wiadomości</label></div></div></div><div class=dialog__buttons-container><button class=button ng-click=success()>Usuń</button><button class="button button--cancel button--margin-left" ng-click=cancel()>Anuluj</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_spam_no_trash.html",'<div ng-controller=SpamNotTrashCtrl><div class="dialog__content dialog__content--with-bulb"><span class="icon icon-dialog-bulb"></span><div class=dialog__content__triangle></div><div ng-bind-html=params.message></div></div><div class=dialog__buttons-container><button class=button ng-click="acceptMovingToSpam(); close();">Tak, przenieś</button> <button class="button button--cancel button--margin-left" ng-click="cancelMovingToSpam(); close(); $event.stopPropagation();">Nie przenoś</button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_transfer_limit_hard.html",'<div class=transfer-limit-hard-board><div class=dialog__content>Wkrótce zostanie nałożona czasowa blokada na wysyłanie i odbieranie e-maili. <a ng-if=!params.additionalData.isInt class=link target=_blank ng-href=https://pomoc.poczta.interia.pl/news-jaka-jest-pojemnosc-konta-pocztowego-w-interia-pl,nId,2136312>więcej informacji</a></div><div class=dialog__buttons-container><a ng-if="!(params.additionalData.isInt || params.additionalData.isPocztaPro)" class="button button--cancel" target=_blank href="https://ustawienia-pocztowe.interia.pl/aktywuj-pakiet?utm_source=autopromo_pdf&utm_medium=plansza&utm_campaign=transfer" ng-click=cancel()>Włącz pakiet z podwyższonym transferem</a> <a ng-if="params.additionalData.isInt || params.additionalData.isPocztaPro" ng-click=close() class="button button--cancel">Ok, rozumiem</a></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_turn_off_ads.html",'<div><div class="dialog__content dialog__content--with-bulb"><span class="icon icon-dialog-bulb"></span><div class=dialog__content__triangle></div><span ng-bind-html=::params.message></span></div><div class=dialog__buttons-container><a class=button ng-click="success(); close(); pushStat(params.additionalData.stat.type, params.additionalData.stat.go)" ng-href={{::params.additionalData.destUrl}} target="{{::params.additionalData.isInNewWindow ? \'_blank\' : \'_self\'}}" ng-bind=::params.additionalData.acceptButtonText></a><button class="button button--cancel button--margin-left" ng-click="close(); cancel(); pushStat(params.additionalData.stat.type, params.additionalData.stat.closeBtn);$event.stopPropagation();" ng-bind=::params.additionalData.cancelButtonText></button></div></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_unsubscribe.html",'<div><div class=dialog__content ng-if=::params.message ng-bind-html=::params.message></div><div class=dialog__buttons-container><button class=button ng-click=success();>{{::params.confirm}}</button><button class="button button--cancel button--margin-left" ng-click=cancel()>{{::params.cancel}}</button></div><a class="link link--read-more" ng-href={{::urls.UNSUBSCRIBE_MAILINGS}} alt="Dowiedz się więcej" target=_blank>Dowiedz się więcej</a></div>'),a.put("o.iplsc.com/n/js/dialog/views/dialog_user_themes.html","<div nxt-user-theme></div>"),a.put("o.iplsc.com/n/js/dialog/views/dialog_view_recommendation.html",'<div ng-controller=ViewRecommendationCtrl><div class="dialog__close icon icon-close ng-scope" ng-click=close()></div><div class="dialog__content dialog__content--with-bulb"><span class="icon icon-dialog-bulb"></span><div class=dialog__content__triangle></div><div>Porządkuj pocztę i korzystaj z automatycznego przenoszenia najpopularniejszych maili z serwisów {{::folder.adjective}} do folderu "{{::folder.name}}"</div><div ng-if=::folderIsOff class=view-recommendation__paragraph>Aktywując folder "{{::folder.name}}", przeniesiemy do niego wszystkie nowo otrzymane maile od:</div><div ng-if=!folderIsOff class=view-recommendation__paragraph>Wyrażając zgodę, przeniesiemy do katalogu "{{::folder.name}}" wszystkie nowo otrzymane maile od:</div><div class="dialog__content__list-item view-recommendation__item" ng-repeat="group in ::groups" ng-bind=::group></div></div><div ng-if=::folderIsOff class="dialog__content dialog__form"><div class="dialog__content dialog__content--checkbox-container"><input id=showInbox class=checkbox type=checkbox name=showInbox ng-true-value=1 ng-false-value=0 ng-model=showInbox.value ng-change=changeShowInboxCheckbox()><label for=showInbox class=checkbox-label>Pozostaw maile również w mojej skrzynce odbiorczej</label></div></div><div class=dialog__buttons-container><button class=button ng-click=save() ng-bind=::confirmText></button><button class="button button--cancel button--margin-left" ng-click=cancel()>Anuluj</button></div></div>'),a.put("o.iplsc.com/n/js/external-account/views/add_alias.html",'<div ng-controller=ExternalAccountAddAliasCtrl><div class=dialog__content>Znudziła Ci się nazwa Twojego konta?<br>Dodaj nową nazwę skrzynki, nie&nbsp;tracąc kontaktów ani&nbsp;aktualnych wiadomości.</div><form name=aliasForm ng-submit="aliasForm.$valid && submit();" ng-class="{\'alias--not-available\': isAvailable == false}"><div class=dialog__form><div class=alias__inputs-container ng-class="{\'alias__inputs-container--error\': isAvailable == false}"><div class=alias__inputs__login><div nxt-input nxt-input-placeholder="Nazwa konta" nxt-input-name=login ng-model=aliasData.login ng-change=checkAlias() nxt-input-pattern=loginPattern nxt-input-error="isAvailable == false || aliasForm.login.$invalid && !aliasForm.login.$pristine" nxt-input-error-message="isAvailable == false ? \'Ten adres jest już zajęty, wpisz inny lub wybierz spośród propozycji poniżej\' : \'Wprowadzona nazwa jest nieprawidłowa\'" ng-model-options="{\n                             debounce: 300\n                         }" nxt-input-scroll-to-focus=dialog__scroll autofocus required></div></div><div class=alias__at ng-class="{\'alias__at--subdomain\': isSubdomain}">@</div><div ng-if=isSubdomain class=alias__inputs__subdomain><div nxt-input nxt-input-placeholder=Subdomena nxt-input-name=subdomain ng-model=aliasData.subdomain ng-change=checkAlias() nxt-input-error="aliasForm.subdomain.$dirty && aliasForm.subdomain.$error" nxt-input-error-message="{\n                        required: \'Podaj subdomenę\'\n                     }" ng-model-options="{\n                             debounce: 300\n                         }" nxt-input-scroll-to-focus=dialog__scroll required></div></div><div ng-if=isSubdomain class=alias__dot>.</div><div class=alias__inputs__domain><div class="input-container input-container--touched-line"><div nxt-dropdown nxt-dropdown-fixed=dropdownPosition nxt-dropdown-width=dropdownWidth nxt-dropdown-select=true nxt-dropdown-text={{aliasData.domain}} nxt-dropdown-icon=arrow><ul class=dropdown__list><li class="dropdown__item alias__item" ng-class="{\'alias__item--active\': domain == aliasData.domain}" ng-repeat="domain in domains" ng-click=selectDomain(domain)><span ng-bind=::domain></span><li class="dropdown__item alias__item" ng-class="{\'alias__item--active\': domain == aliasData.domain}" ng-repeat="domain in domainsWithSubdomains" ng-click=selectDomainWithSubdomain(domain)><span ng-bind="::\'wlasny_adres.\' + domain"></span></ul></div><hr class=input-line></div></div></div><div ng-if=suggestions.length class=alias__suggestions><div class=external-account-form__title>Propozycje adresu e-mail<span ng-if=::!isMobile> dla @{{aliasData.domain}}</span></div><div ng-repeat="alias in suggestions" class=alias__item ng-class="{\'alias__item--active\': alias.login == aliasData.login && alias.domain == aliasData.domain}" ng-click=setAlias(alias)>{{::alias.login + \'@\' + alias.domain}}</div></div><div class="dialog__content dialog__content--checkbox-container"><input id=default class=checkbox type=checkbox name=default ng-true-value=1 ng-false-value=0 ng-model=aliasData.default><label for=default class=checkbox-label>Domyślnie wysyłaj nowe wiadomości z&nbsp;tego konta</label></div></div><div class=dialog__buttons-container><button class=button type=submit ng-disabled="aliasForm.$invalid || isAvailable == false">Zapisz</button><button class="button button--cancel button--margin-left" ng-click=close()>Anuluj</button></div></form></div>'),a.put("o.iplsc.com/n/js/external-account/views/dialog_confirm_del_ext_acc.html",'<div><div class=dialog__content ng-bind-html=params.message></div><div class="dialog__content dialog__form"><input id=isRemove type=checkbox class=checkbox name=isRemove ng-true-value=0 ng-false-value=1 ng-model=params.additionalData.isRemove><label for=isRemove class=checkbox-label>Pozostaw wiadomości po usunięciu konta</label></div><div class=dialog__buttons-container><button class=button ng-click=success();params.additionalData.success(params.additionalData.isRemove)>Usuń</button><button class="button button--cancel button--margin-left" ng-click=cancel()>Anuluj</button></div></div>'),a.put("o.iplsc.com/n/js/external-account/views/main.html",'<div ng-if="type !== TYPES.OFF" class=external-account><div class="external-account__button navigation-button" ng-click=buttonClick()><span ng-if="type == TYPES.ALL_ACCOUNTS" class="icon icon-accounts"></span> <span ng-if="type == TYPES.ALL_ACCOUNTS_ERROR" class="icon icon-accounts-error"></span> <span ng-if="type == TYPES.SELECTED" class="icon icon-contacts" title={{activeAccountName}}></span> <span ng-if="type == TYPES.SELECTED_ERROR" class="icon icon-account-error" title={{activeAccountName}}></span> <span ng-if="type == TYPES.ALL_ACCOUNTS_ERROR || type == TYPES.SELECTED_ERROR" class="icon icon-important-circle" title="{{type == TYPES.SELECTED_ERROR && activeAccountName}}"></span> <span ng-if="type == TYPES.ALL_ACCOUNTS || type == TYPES.ALL_ACCOUNTS_ERROR" class=navigation-item__name>Wszystkie Konta </span><span ng-if="type == TYPES.SELECTED || type == TYPES.SELECTED_ERROR" class=navigation-item__name ng-bind=activeAccountName title={{activeAccountName}}></span> <span ng-if=hasExternalAccounts class="icon icon-arrow" ng-class="{\n                \'icon-arrow-down\': !isListShown,\n                \'icon-arrow-top\': isListShown\n            }"></span> <span ng-if=!hasExternalAccounts class="icon icon-close" ng-click=disable()></span></div><ul ng-if="hasExternalAccounts && isListShown" class=external-account__list><li class="external-account__item external-account__item--title">Pokaż wiadomości z:<li class=external-account__item ng-class="{\n                \'external-account__item--active\': !activeExternalAccountId\n            }" data-tooltip-stop-propagation><a ui-sref="folder({folderId: getActiveFolderId(), page: null})" ui-sref-opts="{inherit: false}" class=navigation-button ng-click=setExternalAccount(false)><div class=external-account__item__radio></div><span>Wszystkie konta</span></a><li class=external-account__item ng-class="{\n                \'external-account__item--active\': activeExternalAccountId === -1\n            }" data-tooltip-stop-propagation><a ui-sref="folder({folderId: getActiveFolderId(), extaccId: mainAccount.id, page: null})" ui-sref-opts="{inherit: false}" class=navigation-button title="{{\'Odebrane z \' + mainAccount.name + \' (\' + mainAccount.folder.stats.total + \')\'}}" ng-click=setExternalAccount(mainAccount.id)><div class=external-account__item__radio></div><span ng-bind=mainAccount.name></span></a><li ng-repeat="account in externalAccounts" class=external-account__item ng-class="{\'external-account__item--active\': activeExternalAccountId == account.id,\n                      \'external-account__item--loader\': account.isLoading,\n                      \'external-account__item--error\': account.isError\n                  }"><a ui-sref="folder({\'folderId\': getActiveFolderId(), \'extaccId\': account.id, \'page\': null})" class=navigation-button data-tooltip="{{account.vsmtpStatus ? \'Odebrane z \' + account.name + \' (\' + account.folder.stats.total + \')\' : account.actionMessage}}" ng-click="account.isError ? showErrorExternalAccountNotification(account) : \'\'; setExternalAccount(account.id)" data-track-click=extAccFilter><div class=external-account__item__radio></div><span ng-bind=::account.name data-tooltip-in-parents data-track-click-iwa=extAccFilter></span> <span ng-if=account.isError ng-click="editExternalAccount(account.id, account.actionMessage, account.isLoading)" class="icon icon-important-circle"></span> <span ng-if=account.isLoading nxt-loading-indicator></span></a><div nxt-dropdown nxt-dropdown-fixed=::dropdownTranslate nxt-dropdown-style=right><ul class=dropdown__list><li class=dropdown__item ng-click="editExternalAccount(account.id, account.actionMessage, account.isLoading)" data-track-click-iwa=extAccEdit>Edytuj<li ng-if="(isAdmin || !isCorp) && !account.ownEmail" class=dropdown__item ng-click=deleteExternalAccount(account) data-track-click-iwa=extAccDelete>Usuń</ul></div><li class="external-account__item link" ng-click=addExternalAccount() data-track-click-iwa=addExtAccLink>+ Dodaj konto</ul></div>'),a.put("o.iplsc.com/n/js/filter/views/dialog_add.html",'<div ng-controller=AddFilterCtrl><div class=dialog__content><div>Przenoś wszystkie nowe wiadomości od tego nadawcy do:</div></div><form class=addFilterForm ng-submit="filterForm.$valid && submit(); $event.preventDefault();" novalidate name=filterForm><div class=dialog__form ng-init="folderMode = \'new\'"><input type=radio name=folder id=newFolder ng-model=folderMode value=new class=radiobutton><label for=newFolder class=radiobutton-label>Nowy folder</label><div nxt-input ng-model=newFolderName ng-focus="folderMode = \'new\'" nxt-input-placeholder="Nazwa folderu" autofocus></div><input type=radio name=folder id=existingFolder ng-model=folderMode value=existing class=radiobutton><label for=existingFolder class=radiobutton-label>Obecny folder</label><div ng-if=folders.length class="input-container input-container--touched-line"><div nxt-dropdown nxt-dropdown-fixed=dropdownPosition nxt-dropdown-select=true nxt-dropdown-text={{selectedFolder.name}} nxt-dropdown-icon=arrow><ul class=dropdown__list><li class=dropdown__item ng-click=selectFolder(f); ng-repeat="f in folders"><span ng-bind=::f.name></span></ul></div><hr class=input-line></div></div><div class=dialog__buttons-container><button ng-disabled="(folderMode === \'new\' && !newFolderName) || (folderMode === \'existing\' && !selectedFolder.id)" ng-click="submit(selectedFolder, newFolderName); close();" class=button>Zapisz</button><button class="button button--cancel button--margin-left" ng-click=cancel();>Anuluj</button></div></form></div>'),a.put("o.iplsc.com/n/js/folder/views/attachments.html","<div class=msglist-attachments-container ng-click=openSlideshow($event); ng-class=\"{\n        'msglist-attachments-container--collapsed': isCollapsed,\n        'msglist-attachments-container--is-more-attachments': isMoreAttachments\n    }\"><ul class=\"msglist-attachments clearfix\"><li ng-if=::!attachment.isHidden class=msglist-attachments__item ng-repeat=\"attachment in ::attachments | filter: {'type': '!image', 'extension': '!pdf'}\" ng-click=$event.stopPropagation();><a ng-href={{::attachment.url}} ng-attr-target=\"{{::attachment.type == 'pdf' ? '_blank' : '_self'}}\" class=\"attachments__item__link msglist-attachments-thumbnail msglist-attachments-thumbnail--icon\" ng-class=\"::'icon icon-file-' + attachment.class\" ng-attr-data-extension={{::attachment.extension.toLowerCase()}} ng-attr-data-tooltip={{::attachment.name}} ng-attr-data-name={{::attachment.name}} data-tooltip-instant ng-click=\"stopDownload($event); openAtt($event, attachment)\"></a></ul><a ng-if=isMoreAttachments href=# class=\"msglist-attachments__item msglist-attachments__item--button\" ng-click=toggleAttachment($event);><span class=icon ng-class=\"isCollapsed ? 'icon-arrow-down' : 'icon-arrow-top'\"></span></a></div>"),a.put("o.iplsc.com/n/js/folder/views/dialog_edit.html",'<div ng-controller=FolderEditCtrl><form class=add-folder-form ng-submit="folderForm.$valid && submit(); $event.preventDefault();" novalidate name=folderForm><div class=dialog__form><div nxt-input nxt-input-placeholder="Nazwa folderu" nxt-input-name=name ng-model=folder.name nxt-input-pattern=specialCharsPattern nxt-input-error="folderForm.name.$dirty && folderForm.name.$error" nxt-input-error-message=::errorMessage required autofocus></div><div ng-if=::sortListFolder.length class="input-container input-container--touched-line"><div nxt-dropdown nxt-dropdown-fixed=dropdownPosition nxt-dropdown-select=true nxt-dropdown-text={{selectedFolder.name}} nxt-dropdown-icon=arrow><ul class=dropdown__list><li class=dropdown__item ng-click=selectFolder(noFolder);><span>Brak folderu nadrzędnego</span><li class=dropdown__item ng-click=selectFolder(f); ng-repeat="f in ::sortListFolder | filter:{id:\'!\' + folder.id}"><span ng-bind=::f.name></span></ul></div><hr class=input-line></div></div><div class=dialog__buttons-container><button class=button type=submit ng-disabled=folderForm.$invalid>Zapisz</button><button class="button button--cancel button--margin-left" ng-click=cancel()>Anuluj</button></div></form></div>'),a.put("o.iplsc.com/n/js/folder/views/main.html",'<div class="msglist-section-container msglist-section-container--folder{{::folder.id}}" ng-class="{\n        \'msglist-section-container--with-loading-more\': isMessagesLoading,\n        \'msglist-section-container--scrollToPage\': isFolderScrollToPage\n    }"><div class=msglist-section-container-wrapper nxt-ui-events-data="{\'panel\': \'folder\'}"><div nxt-damage-message nxt-stop-click-propagation></div><header class=msglist-header-container><section class=msglist-header><h1 ng-if="folder.name && !isSearch && !isSearchExpanded" class=msglist-header__folder-name ng-attr-title={{::folder.name}} ng-bind=::folder.name></h1><div nxt-search nxt-search-is-expanded=isSearchExpanded></div></section><section class=msglist-toolbar><input type=checkbox class=checkbox id=isSelectAllView ng-click=selectAllView() ng-checked=isSelectAllView><label for=isSelectAllView class="checkbox-label msglist-toolbar-checkbox" ng-class="{\'checkbox-label--partial\': isSelectAllView === SELECT_ALL_STATE.PARTIAL}"></label><div ng-if=!avatarsShowed class=msglist-toolbar__show-avatars><span class="icon icon-avatar-off" ng-click=showAvatars() data-tooltip={{::dataTooltip.SHOW_AVATAR}} data-track-click-iwa=showAvatarsToolBar></span></div><div ng-if=avatarsShowed class=msglist-toolbar__show-avatars><span class="icon icon-avatar-on" ng-click=showAvatars() data-tooltip={{::dataTooltip.HIDE_AVATAR}} data-track-click-iwa=hideAvatarsToolBar></span></div><ul ng-if=folder.name class=msglist-toolbar__filters><li class=msglist-toolbar__filters__item ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'all\'}" data-tooltip={{::dataTooltip.FILTER_SHOW_ALL}}><a class="icon icon-inbox" ng-click="changeFilter(\'all\')" ui-sref="folder({\'filter\': null, \'mode\': null, \'page\': null})" data-tooltip={{::dataTooltip.FILTER_SHOW_ALL}} data-track-click=filterAllToolBar data-track-click-iwa=partialFilterAllToolBar aria-label="Pokaż wszystkie wiadomości" role=button></a><li ng-if="::folder.isBilling && !isSearch" class="msglist-toolbar__filters__item msglist-toolbar__filters__item--billing" ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'p\'}" data-tooltip={{::dataTooltip.FILTER_SHOW_PAID}}><a class="icon icon-paid" ng-click="changeFilter(\'p\')" ui-sref="folder({\'filter\': \'p\', \'mode\': null, \'page\': null})" data-tooltip={{::dataTooltip.FILTER_SHOW_PAID}} data-track-click-iwa=partialFilterPaidToolBar aria-label="Pokaż wiadomości zapłacone" role=button></a><li ng-if="::folder.isBilling && !isSearch" class="msglist-toolbar__filters__item msglist-toolbar__filters__item--billing" ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'up\'}" data-tooltip={{::dataTooltip.FILTER_SHOW_PAYMENT_REQUIRED}}><a class="icon icon-not-paid" ng-click="changeFilter(\'up\')" ui-sref="folder({\'filter\': \'up\', \'mode\': null, \'page\': null})" data-tooltip={{::dataTooltip.FILTER_SHOW_PAYMENT_REQUIRED}} data-track-click-iwa=partialFilterNotPaidToolBar aria-label="Pokaż wiadomości do zapłaty" role=button></a><li class=msglist-toolbar__filters__item ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'fs\'}" data-tooltip={{::dataTooltip.FILTER_SHOW_STARRED}}><a class="icon icon-star" ng-click="changeFilter(\'fs\')" ui-sref="folder({\'filter\': \'fs\', \'mode\': null, \'page\': null})" data-tooltip={{::dataTooltip.FILTER_SHOW_STARRED}} data-track-click=filterStarsToolBar data-track-click-iwa=partialFilterStarsToolBar aria-label="Pokaż wiadomości z gwiazdką" role=button></a><li ng-if="::!folder.isBilling || isSearch" class=msglist-toolbar__filters__item ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'a\'}" data-tooltip={{::dataTooltip.FILTER_SHOW_ATTACHMENTS}}><a class="icon icon-attachment" ng-click="changeFilter(\'a\')" ui-sref="folder({\'filter\': \'a\', \'mode\': \'attachments\', \'page\': null})" data-tooltip={{::dataTooltip.FILTER_SHOW_ATTACHMENTS}} data-track-click=filterAttachToolBar data-track-click-iwa=partialFilterAttachToolBar aria-label="Pokaż wiadomości z załącznikami" role=button></a><li class=msglist-toolbar__filters__item ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'u\'}"><a class="icon icon-unread" ng-click="changeFilter(\'u\')" ui-sref="folder({\'filter\': \'u\', \'mode\': null, \'page\': null})" data-tooltip={{::dataTooltip.FILTER_SHOW_UNREAD}} data-track-click=selectUnReadMainToolBar data-track-click-iwa=partialSelectUnReadMainToolBar aria-label="Pokaż wiadomości nieprzeczytane" role=button></a><li ng-if="::!folder.isBilling || isSearch" class=msglist-toolbar__filters__item ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'c\'}" data-tooltip={{::dataTooltip.FILTER_SHOW_CONTACT}}><a class="icon icon-contacts" ng-click="changeFilter(\'c\')" ui-sref="folder({\'filter\': \'c\', \'mode\': null, \'page\': null})" data-tooltip={{::dataTooltip.FILTER_SHOW_CONTACT}} data-track-click=filterContactsToolBar data-track-click-iwa=partialFilterContactsToolBar aria-label="Pokaż wiadomości od znajomych" role=button></a></ul></section><section ng-if=folder.name class=msglist-action-bar ng-show=isAnyMessageChecked><div class=msglist-action-bar__button ng-if=::!folder.isDrafts ng-click=forward(); data-tooltip={{::dataTooltip.FORWARD}}><span class="icon icon-forward" data-tooltip-in-parents></span> <span class=msglist-action-bar__button-text data-tooltip-in-parents>Prześlij</span></div><div class=msglist-action-bar__button ng-if="::!folder.isSent && !folder.isDrafts && !folder.isSpam && !folder.isBilling" ng-click=moveToSpam(); data-tooltip={{::dataTooltip.MOVE_TO_SPAM}}><span class="icon icon-spam" data-tooltip-in-parents></span> <span class=msglist-action-bar__button-text data-tooltip-in-parents>Spam!</span></div><div class=msglist-action-bar__button ng-if=::folder.isSpam ng-click=moveToUnSpam(); data-tooltip={{::dataTooltip.MOVE_TO_UNSPAM}}><span class="icon icon-not-spam" data-tooltip-in-parents></span> <span class=msglist-action-bar__button-text data-tooltip-in-parents>To nie spam</span></div><div class=msglist-action-bar__button ng-if="::!folder.isTrash && !folder.isSpam" ng-click=moveCheckedToTrash(); data-tooltip={{::dataTooltip.DELETE_MESSAGES}}><span class="icon icon-trash" data-tooltip-in-parents></span> <span class=msglist-action-bar__button-text data-tooltip-in-parents>Usuń</span></div><div class=msglist-action-bar__button ng-if="::folder.isTrash || folder.isSpam" ng-click=deleteMessages(); data-tooltip={{::dataTooltip.DELETE_MESSAGES}}><span class="icon icon-trash" data-tooltip-in-parents></span> <span class=msglist-action-bar__button-text data-tooltip-in-parents>Usuń na zawsze</span></div><div class="msglist-action-bar__button msglist-action-bar__button--move" ng-if="::!folder.isDrafts && !folder.isSpam" data-tooltip="{{folder.isTrash ? dataTooltip.MOVE_TO_INBOX : dataTooltip.MOVE_TO_FOLDER}}"><div ng-if="userFolders.length !== undefined" nxt-dropdown ng-init="isLast = false" nxt-dropdown-change=isLast nxt-dropdown-icon=folder nxt-dropdown-always-bottom=true><ul class=dropdown__list><li class=dropdown__item ng-click=moveFunctions[folder.moveFunction](folder.id) ng-repeat="folder in moveFolders | orderBy: folder.order">{{::folder.name}}</li><div ng-if="userFolders.length > 0" class=dropdown__separator></div><li ng-if=!folder.parentId class="dropdown__item user-folder" ng-repeat="folder in userFolders" ng-init="$parent.isLast = $last" data-track-click="{{isSelectAllView ? \'moveAllCheckMesToUserFolder\' : \'moveMesToUserFolder\'}}" ng-class="{\'user-folder--with-sub\': folder.subFolders && folder.subFolders.length,\n                                    \'dropdown__item--top-separator\': $index === 0\n                                }"><div ng-click=moveToFolder(folder.id)>{{folder.name}}</div><ul class=dropdown__list ng-if="folder.subFolders && folder.subFolders.length"><li class="dropdown__item user-folder--sub" ng-repeat="subfolder in folder.subFolders" ng-click=moveToFolder(subfolder.id) data-track-click="{{isSelectAllView ? \'moveAllCheckMesToUserFolder\' : \'moveMesToUserFolder\'}}">{{subfolder.name}}</ul></li><div ng-if=isShowAddQuickFilter() class=dropdown__separator></div><li ng-if=isShowAddQuickFilter() class="dropdown__item dropdown__item--checkbox no-hidden" ng-click=quickFilter()><input id=folder-filter-value class=checkbox type=checkbox ng-model=isAddQuickFilter><label for=folder-filter-value class="checkbox-label no-close" title="Zastosuj do wszystkich przyszłych wiadomości od tego nadawcy">Zastosuj do wszystkich przyszłych wiadomości od tego nadawcy</label></ul></div><span class=msglist-action-bar__button-text ng-bind="(folder.isTrash ? \'Przywróć\' : \'Przenieś\')" data-tooltip-in-parents></span></div><div class="msglist-action-bar__button msglist-action-bar__button--more" ng-if=::!folder.isDrafts data-tooltip={{::dataTooltip.SHOW_MORE_OPTIONS}}><div nxt-dropdown nxt-dropdown-icon=dots><ul class=dropdown__list><li class=dropdown__item ng-hide="checkedMessagesCount > 1" ng-click=reply()>Odpowiedz<li class=dropdown__item ng-click=markAsRead() ng-if=::!folder.isBilling>Oznacz jako przeczytane<li class=dropdown__item ng-click=markAsUnread() ng-if=::!folder.isBilling>Oznacz jako nieprzeczytane<li class=dropdown__item ng-click=markAsPaid() ng-if="folder.isBilling && isAnyMessageNotPaid">Oznacz jako zapłacona<li class=dropdown__item ng-click=markAsNotPaid() ng-if="folder.isBilling && isAnyMessagePaid">Oznacz jako niezapłacona<li class=dropdown__item ng-click=markAsFavorite() ng-if=isAnyMessageUnstarred>Oznacz gwiazdką<li class=dropdown__item ng-click=markAsFavorite() ng-if=isAnyMessageStarred>Usuń gwiazdkę<li class=dropdown__item ng-click=sendAsAttachment()>Prześlij jako załącznik</ul></div><span class=msglist-action-bar__button-text data-tooltip-in-parents>Więcej</span></div><div ng-click="clearSelection((isSelectAllView ? \'topPanelCloseCheckAll\' : \'topPanelCloseCheckSingle\'));" class="icon icon-close" nxt-stop-click-propagation></div></section></header><section ng-if=folder.name class=msglist-container ng-class="{\n                        \'msglist-container--empty\': messages.length === 0 && !isSearch && !isCorp && !isBusinessAccount && !isInt,\n                        \'is-damage\': isDamage,\n                    }" nxt-scroll-detector=msglist:scroll nxt-scroll-to-last-pos=messages[0]><div ng-if="messages.length && folder" nxt-message-banner></div><div ng-if="isFolderLoading || folderIsFrozen" class=loader-container nxt-loading-indicator nxt-loading-indicator-text="{{folderIsFrozen ? \'Trwa operacja na tym folderze...\' : \'\'}}"></div><div ng-if=::isShowBillingToolbar class="msglist-toolbar msglist-toolbar--info {{::billingToolbarConfig.additionalClass}}"><div class=msglist-toolbar--info__content><div ng-if=::billingToolbarConfig.avatarImg class="msglist-avatar avatar"><div class=avatar__content style="background-image: url(\'{{::billingToolbarConfig.avatarImg}}\')"></div></div><div ng-if=::!billingToolbarConfig.url ng-bind-html=::billingToolbarConfig.text></div><a ng-if=::billingToolbarConfig.url ng-href={{::billingToolbarConfig.url}} data-track-click-iwa=messageBannerClick data-track-click-iwa-params={{::billingToolbarConfig.url}} target=_blank class="link link--no-margin" ng-bind-html=::billingToolbarConfig.text></a></div></div><div ng-if="isShowSubscriptionExpireReminder && folder.isInbox" class="msglist-toolbar msglist-toolbar--reminder" ng-class="{\n                    \'msglist-toolbar--reminder-tomorrow\': daysToExpire === 1,\n                }"><div class=msglist-toolbar__content><div class=msglist-toolbar__content-container><div class=msglist-toolbar__icon-wrapper><span class="icon {{::subscriptionExpireReminder.icon}}"></span></div><div class=msglist-toolbar__text-container><div class=msglist-toolbar__text><span ng-bind-html=::subscriptionExpireReminder.text></span> <span class=msglist-toolbar__badge><span ng-bind-html=::subscriptionExpireReminder.badge></span></span></div><a ng-if=::subscriptionExpireReminder.url ng-href={{::subscriptionExpireReminder.url}} ng-click=trackUrlClick() target=_blank class="link link--no-margin link--color-inherit msglist-toolbar__link" ng-bind-html=::subscriptionExpireReminder.urlText></a></div></div><div class=msglist-toolbar__icon-close ng-click=closeSubscriptionReminder()><span class="icon icon-close"></span></div></div></div><div ng-if="hasBillingFolder && folder.isInbox && !isSearch" nxt-billing-notification></div><div ng-if="isFolderUnfreeze !== undefined && !isSearch" class=msglist-toolbar--info><span class=msglist-toolbar--info__content ng-bind="\'Operacja na tym folderze zakończyła się \' + (isFolderUnfreeze ? \'powodzeniem\' : \'niepowodzeniem\')"></span></div><div ng-if=messages.length nxt-messages-list-top></div><div id=drag-info class=msglist-drag-info><p>Wątek do przeniesienia</div><ul ng-if=messages.length class=msglist ng-class="{\n                    \'msglist-drafts\': folder.isDrafts,\n                    \'msglist--without-avatar\': !avatarsShowed,\n                    \'msglist-shoping\': folder.isShopping\n                }"><li nxt-email-dragzone=message draggable=true ng-repeat="message in messages" class=msglist-item id={{::message.uniqueId}} ng-class="{\'msglist-item--highlight\': message.highlight,\n                               \'msglist-item--highlight--other\': messages[$index - 1].highlight && !message.highlight,\n                               \'msglist-item--seen\': message.seen,\n                               \'msglist-item--active\': message.uniqueId === activeUniqueId,\n                               [\'msglist-item--\' + message.additionalClass]: message.additionalClass\n                           }"><div class=msglist-item__message__precontainer><input type=checkbox class=checkbox ng-attr-id="{{::\'message-\' + message.uniqueId}}" ng-checked=message.checked><label class="checkbox-label msglist-checkbox" ng-attr-for="{{::\'message-\' + message.uniqueId}}" ng-click="checkMessage(message, $event.shiftKey); $event.preventDefault();"></label><div ng-if=avatarsShowed class=msglist-avatar nxt-avatar nxt-avatar-list=message.avatarList nxt-avatar-contact-name=message.fromName nxt-avatar-contact-email=message.fromEmail nxt-message-sender-info=message.senderInfo nxt-avatar-options="{\'isCardEnabled\': message.totalFrom == 1}" nxt-avatar-is-thread=true></div></div><div class=msglist-item__message><div class=msglist-item__link ng-click=openMessage(message) ng-attr-accesskey={{::message.accessKey}} tabindex="{{::100 + $index}}" ng-focus=focusLastMessage($last) aria-label="{{::\'Nadawca: \' + message.fromString +  \'. Temat: \' + (message.subject || \'(brak tematu)\')}}"><div aria-hidden=true><div class=msglist-item__message__sender><i ng-if=::message.senderInfo.safe class="icon icon-padlock" data-tooltip-bubble=0></i> <span ng-bind=::message.fromString ng-attr-title="{{::message.fromEmail || message.fromString}}"></span></div><div class=msglist-item__message__subject ng-attr-title="{{::message.subject || \'(brak tematu)\'}}"><span ng-if="::message.priority == \'high\'" class="icon icon-important"></span><span ng-if="::message.hasAtta && !message.billing" class="icon icon-attachment"> </span><span ng-if=::isSearch class=msglist-item__message__subject-folder ng-bind=foldersMap[message.folderId].name></span><span class=msglist-item__message__subject-text ng-bind="::(message.subject || \'(brak tematu)\')"> </span><span ng-if="::isThreadingOn && message.msgCount > 1" class=msglist-item__message__subject__counter ng-bind=::message.msgCount></span></div><div ng-if="::isSearch && message.snippet" class=msglist-item__message-snippet ng-bind-html="::message.snippet | safehtml"></div><div ng-if=message.schema.type nxt-list-schema nxt-list-schema-data=::message.schema></div><div ng-if="::message.atta.length && !message.billing" nxt-attachments nxt-attachments-data=message nxt-attachments-collapsed=!isModeAttachments></div></div></div><div ng-if=message.billing nxt-billing-panel=message.billing nxt-billing-panel-type=folder nxt-billing-panel-open-message=openMessage(message) class=msglist-item__message__billing></div><div class=msglist-item__message__postcontainer ng-bind=::message.formatDate ng-attr-data-tooltip="{{::message.date || message.msgs[2].date || message.msgs[1].date}}" aria-hidden=true></div></div><div class=msglist-item__panel><span ng-if=message.answered class="icon icon-reply-list"></span><span ng-if=message.forwarded class="icon icon-forward-list"> </span><span ng-if="::!folder.isSent && !folder.isDrafts && !folder.isSpam" class="icon icon-spam" ng-click="moveToSpam(message, $index);" data-tooltip={{::dataTooltip.MOVE_TO_SPAM}}></span><span ng-if=::folder.isSpam class="icon icon-not-spam" ng-click="moveToUnSpam(message, $index);" data-tooltip={{::dataTooltip.MOVE_TO_UNSPAM}}> </span><span ng-if="::!folder.isTrash && !folder.isSpam" class="icon icon-trash" ng-click="moveToTrash(message, $index);" data-tooltip={{::dataTooltip.DELETE_MESSAGE}}></span><span ng-if="::folder.isTrash || folder.isSpam" class="icon icon-trash" ng-click="deleteMessages(message, $index);" data-tooltip={{::dataTooltip.DELETE_MESSAGE_PERMANENT}}> </span><span ng-class="message.isStarred ? \'icon-star-full\' : \'icon-star\'" class=icon ng-click="markAsFavorite(message); $event.preventDefault();" data-tooltip="{{message.isStarred ? dataTooltip.REMOVE_STAR : dataTooltip.MARK_WITH_STAR}}"></span></div></ul><div ng-if="(isMoreMessages || isMoreMessagesLoading) && messages.length >= 25" class="loader-container loader-container--msglist" nxt-loading-indicator></div><div class=msglist-empty ng-if="!activeRemarketing && messages.length == 0 && folder"><div ng-if="::isCorp || isBusinessAccount || isInt" class="msglist-empty-icon icon" ng-class="::{\'icon-inbox\'   : folder.id == foldersMap.INBOX,\n                                \'icon-offer\': folder.isShopping,\n                                \'icon-social\'  : folder.isSocial,\n                                \'icon-sent\'    : folder.id == foldersMap.SENT,\n                                \'icon-drafts\'  : folder.id == foldersMap.DRAFTS,\n                                \'icon-trash\'   : folder.id == foldersMap.TRASH,\n                                \'icon-spam\'    : folder.id == foldersMap.SPAM,\n                                \'icon-folder\'  : !folder.isShopping && !folder.isSocial && !folder.isSystem}"></div><div ng-if=!isSearch><h2 ng-if="::isCorp || isBusinessAccount || isInt" class=msglist-empty-header>Ten folder jest pusty</h2><p ng-if="::(isCorp || isInt) && (folder.isSpam || folder.isTrash)" class=msglist-empty-info ng-bind="::\'Wiadomości z&nbsp;folderu \' + folder.name + \' są&nbsp;automatycznie usuwane po&nbsp;30&nbsp;dniach\'"><div ng-if="::!isCorp && !isBusinessAccount && !isInt" nxt-ad-place=box_empty_folder nxt-ad-folder=::folder.name></div></div><div ng-if=isSearch><h2 class=msglist-empty-header>Nie znaleziono wyników pasujących do&nbsp;zapytania</h2><p class=msglist-empty-info ng-if=!isSearchInContent><a href=# ng-click="advancedSearch(); $event.preventDefault();" class=link>Przeszukaj dodatkowo treść wiadomości</a></div></div><div ng-if="::(!isCorp && !isBusinessAccount && !isInt && !isSearch) && (folder.isSpam || folder.isTrash)" ng-show="messages.length == 0" class=msglist-empty-info>Wiadomości z&nbsp;folderu {{::folder.name}}<br>są&nbsp;automatycznie usuwane po&nbsp;30&nbsp;dniach</div></section></div><div nxt-columns-resize></div></div><div nxt-avatar-card></div><div nxt-mail-notification></div><div nxt-tooltip></div><div nxt-tooltip-bubble></div>'),a.put("o.iplsc.com/n/js/folder/views/main_mobile.html",'<div class="msglist-section-container msglist-section-container--folder{{::folder.id}}" ng-swipe-right="openNavigation(true); $event.stopPropagation();"><div ng-if="speechCommands.length && speech.indicator === \'listening\' && !isNavigationOpen" class=voice-assistant-commands><div class=voice-assistant-commands__content><strong>Wypróbuj jedną z komend:</strong><ul><li ng-repeat="command in speechCommands">{{::command}}</ul></div></div><div ng-show="speech.indicator && !isNavigationOpen" class=voiceAssistantIndicator><div ng-if="speech.indicator === \'listening\'" class=voiceAssistantIndicator__content><div class=speech-animation-wrapper nxt-speech-indicator-animation nxt-animation-name="\'listening\'"></div><p>Nasłuch...</div><div ng-if="speech.indicator === \'speaking\'" class=voiceAssistantIndicator__content><div class=speech-animation-wrapper nxt-speech-indicator-animation nxt-animation-name="\'reading\'"></div><p>Czytam...</div></div><div class=msglist-section-container-wrapper><header nxt-stop-touch-move-propagation class=msglist-header-container><div nxt-damage-message nxt-stop-click-propagation></div><section class=navigation-header><div class=navigation-header__not-search ng-class="{\'navigation-header--speech-active\': speech.icon === speechIconStates[2]}"><div class="icon icon-hamburger navigation-header__hamburger" ng-class="{\'navigation-header__hamburger--with-counter\': unseenMessageCount}" ng-click="openNavigation(); $event.stopPropagation();"><div nxt-navigation-counter={{unseenMessageCount}} nxt-navigation-counter-sum></div></div><span class=navigation-header__title ng-bind=::folder.name></span><div ng-if="speech.icon !== speechIconStates[0]" class="list voiceAssistant-icon" ng-click="speechToggle(\'list\');" nxt-speech-icon-animation nxt-background-color="\'dark\'"></div><div class=list nxt-bubble=-2 nxt-bubble-extra-padd="[80, 0]"></div><div nxt-search nxt-search-is-expanded=isSearchExpanded></div><div class="icon icon-new-message navigation-header__composition" ng-click=openComposition();></div></div><div class=newsfeed-player><div id=newsfeed-player></div></div></section><section ng-if=folder.name class="msglist-toolbar msglist-toolbar--filters" ng-class="{\'msglist-toolbar--unchecked\': !isAnyMessageChecked}"><input type=checkbox class=checkbox id=isSelectAllView ng-click=selectAllView() ng-checked=isSelectAllView><label for=isSelectAllView class="checkbox-label msglist-toolbar-checkbox" ng-class="{\'checkbox-label--partial\': isSelectAllView === SELECT_ALL_STATE.PARTIAL}"></label><div ng-if=!avatarsShowed class=msglist-toolbar__show-avatars><span class="icon icon-avatar-off" ng-click=showAvatars() data-track-click-iwa=showAvatarsToolBar></span></div><div ng-if=avatarsShowed class=msglist-toolbar__show-avatars><span class="icon icon-avatar-on" ng-click=showAvatars() data-track-click-iwa=hideAvatarsToolBar></span></div><ul class=msglist-toolbar__filters><li class=msglist-toolbar__filters__item ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'all\'}"><a class="icon icon-inbox" ng-click="changeFilter(\'all\')" ui-sref="folder({\'filter\': null, \'mode\': null, \'page\': null})" ui-sref-opts="{reload: true}" data-track-click=filterAllToolBar data-track-click-iwa=partialFilterAllToolBar></a><li ng-if="::folder.isBilling && !isSearch" class="msglist-toolbar__filters__item msglist-toolbar__filters__item--billing" ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'p\'}"><a class="icon icon-paid" ng-click="changeFilter(\'p\')" ui-sref="folder({\'filter\': \'p\', \'mode\': null, \'page\': null})" ui-sref-opts="{reload: true}" data-track-click-iwa=partialFilterPaidToolBar></a><li ng-if="::folder.isBilling && !isSearch" class="msglist-toolbar__filters__item msglist-toolbar__filters__item--billing" ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'up\'}"><a class="icon icon-not-paid" ng-click="changeFilter(\'up\')" ui-sref="folder({\'filter\': \'up\', \'mode\': null, \'page\': null})" ui-sref-opts="{reload: true}" data-track-click-iwa=partialFilterNotPaidToolBar></a><li class=msglist-toolbar__filters__item ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'fs\'}"><a class="icon icon-star" ng-click="changeFilter(\'fs\')" ui-sref="folder({\'filter\': \'fs\', \'mode\': null, \'page\': null})" ui-sref-opts="{reload: true}" data-track-click=filterStarsToolBar data-track-click-iwa=partialFilterStarsToolBar></a><li ng-if="::!folder.isBilling || isSearch" class=msglist-toolbar__filters__item ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'a\'}"><a class="icon icon-attachment" ng-click="changeFilter(\'a\')" ui-sref="folder({\'filter\': \'a\', \'mode\': \'attachments\', \'page\': null})" ui-sref-opts="{reload: true}" data-track-click=filterAttachToolBar data-track-click-iwa=partialFilterAttachToolBar></a><li class=msglist-toolbar__filters__item ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'u\'}"><a class="icon icon-unread" ng-click="changeFilter(\'u\')" ui-sref="folder({\'filter\': \'u\', \'mode\': null, \'page\': null})" ui-sref-opts="{reload: true}" data-track-click=selectUnReadMainToolBar data-track-click-iwa=partialSelectUnReadMainToolBar></a><li ng-if="::!folder.isBilling || isSearch" class=msglist-toolbar__filters__item ng-class="{\'msglist-toolbar__filters__item--active\': activeFilter == \'c\'}"><a class="icon icon-contacts" ng-click="changeFilter(\'c\')" ui-sref="folder({\'filter\': \'c\', \'mode\': null, \'page\': null})" ui-sref-opts="{reload: true}" data-track-click=filterContactsToolBar data-track-click-iwa=partialFilterContactsToolBar></a></ul></section><section ng-if=folder.name class=msglist-action-bar ng-show=isAnyMessageChecked><div class=msglist-action-bar__button ng-if=::!folder.isDrafts ng-click=forward();><span class=msglist-action-bar__button-text>Prześlij</span></div><div class=msglist-action-bar__button ng-if="::!folder.isSent && !folder.isDrafts && !folder.isSpam" ng-click=moveToSpam();><span class=msglist-action-bar__button-text>Spam</span></div><div class=msglist-action-bar__button ng-if=::folder.isSpam ng-click=moveToUnSpam();><span class=msglist-action-bar__button-text>To nie spam</span></div><div class=msglist-action-bar__button ng-if="::!folder.isTrash && !folder.isSpam" ng-click=moveCheckedToTrash();><span class=msglist-action-bar__button-text>Usuń</span></div><div class="msglist-action-bar__button msglist-action-bar__button--move" ng-if="::!folder.isDrafts && !folder.isSpam" ng-class="::{\'msglist-action-bar-button--restore\': folder.isTrash}"><div ng-if="userFolders.length !== undefined" nxt-dropdown nxt-dropdown-icon=void ng-init="isLast = false" nxt-dropdown-change=isLast nxt-dropdown-always-bottom=true><ul class=dropdown__list><li class=dropdown__item ng-click=moveFunctions[folder.moveFunction](folder.id) ng-repeat="folder in moveFolders | orderBy: folder.order">{{::folder.name}}</li><div ng-if="userFolders.length > 0" class=dropdown__separator></div><li ng-if=!folder.parentId class="dropdown__item user-folder" ng-repeat="folder in userFolders" ng-init="$parent.isLast = $last" data-track-click="{{isSelectAllView ? \'moveAllCheckMesToUserFolder\' : \'moveMesToUserFolder\'}}" ng-class="{\'user-folder--with-sub\': folder.subFolders && folder.subFolders.length}"><div ng-click=moveToFolder(folder.id)>{{folder.name}}</div><ul class=dropdown__list ng-if="folder.subFolders && folder.subFolders.length"><li class="dropdown__item user-folder--sub" ng-repeat="subfolder in folder.subFolders" ng-click=moveToFolder(subfolder.id) data-track-click="{{isSelectAllView ? \'moveAllCheckMesToUserFolder\' : \'moveMesToUserFolder\'}}">{{subfolder.name}}</ul></li><div ng-if=isShowAddQuickFilter() class=dropdown__separator></div><li ng-if=isShowAddQuickFilter() class="dropdown__item dropdown__item--checkbox dropdown__item--checkbox-multiline no-hidden" ng-click=quickFilter()><input id=folder-filter-value class=checkbox type=checkbox ng-model=isAddQuickFilter><label for=folder-filter-value class="checkbox-label no-close">Zastosuj do wszystkich przyszłych wiadomości od&nbsp;tego&nbsp;nadawcy</label></ul></div><span class=msglist-action-bar__button-text>Przenieś</span></div><div class="msglist-action-bar__button msglist-action-bar__button--more" ng-if=::!folder.isDrafts><div nxt-dropdown><ul class=dropdown__list><li ng-if="::folder.isTrash || folder.isSpam" class=dropdown__item ng-click=deleteMessages()>Usuń na zawsze<li class=dropdown__item ng-hide="checkedMessagesCount > 1" ng-click=reply() data-track-click-iwa=messageListToolboxReply>Odpowiedz<li class=dropdown__item ng-click=markAsRead()>Oznacz jako przeczytane<li class=dropdown__item ng-click=markAsUnread()>Oznacz jako nieprzeczytane<li class=dropdown__item ng-click=markAsFavorite() ng-if=isAnyMessageUnstarred>Oznacz gwiazdką<li class=dropdown__item ng-click=markAsFavorite() ng-if=isAnyMessageStarred>Usuń gwiazdkę<li class=dropdown__item ng-click=sendAsAttachment()>Prześlij jako załącznik</ul></div></div><div class="icon icon-close" ng-click="clearSelection((isSelectAllView ? \'topPanelCloseCheckAll\' : \'topPanelCloseCheckSingle\'));"></div></section></header><div ng-if="!folder.name || isFolderLoading || folderIsFrozen" class=loader-container nxt-loading-indicator nxt-loading-indicator-text="{{folderIsFrozen ? \'Trwa operacja na tym folderze...\' : \'\'}}"></div><section ng-if=folder.name class=msglist-container ng-class="{\n                    \'msglist-container--empty\': messages.length === 0 && !isSearch && !isCorp && !isBusinessAccount && !isInt,\n                    \'is-damage-mobile\': isDamage,\n                 }" nxt-scroll-detector=msglist:scroll nxt-scroll-to-page nxt-scroll-to-last-pos=messages[0]><div class=msglist-toolbar__adv ng-if="isShowAds && messages.length && (isMobileApp || (!isMobileApp && !folder.isShopping))" nxt-list-adv><div ng-if=isOpen class=ad-msglist-toolbar__title><div class=ad-msglist-toolbar__title__content>Reklama</div></div><div nxt-ad-place=m_gora_srodek ng-if=isOpen ng-show=!isMessagesLoading class=message_ad-place></div></div><div ng-if="messages.length && folder" nxt-message-banner></div><div class="msglist-toolbar msglist-toolbar--extra" ng-if="isFolderUnfreeze !== undefined && !isSearch" ng-bind="\'Operacja na tym folderze zakończyła się \' + (isFolderUnfreeze ? \'powodzeniem\' : \'niepowodzeniem\')"></div><div ng-if=::isShowBillingToolbar class="msglist-toolbar msglist-toolbar--info {{::billingToolbarConfig.additionalClass}}"><div class=msglist-toolbar--info__content><div ng-if=::billingToolbarConfig.avatarImg class="msglist-avatar avatar"><div class=avatar__content style="background-image: url(\'{{::billingToolbarConfig.avatarImg}}\')"></div></div><div ng-if=::!billingToolbarConfig.url ng-bind-html=::billingToolbarConfig.text></div><a ng-if=::billingToolbarConfig.url ng-href={{::billingToolbarConfig.url}} data-track-click-iwa=messageBannerClick data-track-click-iwa-params={{::billingToolbarConfig.url}} target=_blank class="link link--no-margin" ng-bind-html=::billingToolbarConfig.text></a></div></div><div ng-if="isShowSubscriptionExpireReminder && folder.isInbox" class="msglist-toolbar msglist-toolbar--reminder" ng-class="{\n                    \'msglist-toolbar--reminder-tomorrow\': daysToExpire === 1,\n                }"><div class=msglist-toolbar__content><div class=msglist-toolbar__content-container><div class=msglist-toolbar__icon-wrapper><span class="icon {{::subscriptionExpireReminder.icon}}"></span></div><div class=msglist-toolbar__text-container><div class=msglist-toolbar__text><span ng-bind-html=::subscriptionExpireReminder.text></span> <span class=msglist-toolbar__badge><span ng-bind-html=::subscriptionExpireReminder.badge></span></span></div><a ng-if=::subscriptionExpireReminder.url ng-href={{::subscriptionExpireReminder.url}} data-click=trackUrlClick() target=_blank class="link link--no-margin link--color-inherit msglist-toolbar__link" ng-bind-html=::subscriptionExpireReminder.urlText></a></div></div><div class=msglist-toolbar__icon-close ng-click=closeSubscriptionReminder()><span class="icon icon-close"></span></div></div></div><ul class=msglist><div ng-if="hasBillingFolder && folder.isInbox && !isSearch" nxt-billing-notification></div></ul><div ng-if=messages.length nxt-messages-list-top></div><ul class=msglist ng-if=messages.length ng-class="{\n                    \'msglist-drafts\': folder.isDrafts,\n                    \'msglist--without-avatar\': !avatarsShowed,\n                    \'msglist-show-checkboxes\': isAnyMessageChecked,\n\n                }"><li ng-repeat="message in messages" class=msglist-item id={{::message.uniqueId}} ng-class="{\'msglist-item--highlight\': message.highlight,\n                                \'msglist-item--highlight--other\': messages[$index - 1].highlight && !message.highlight,\n                                \'msglist-item--seen\': message.seen,\n                                \'msglist-item--hidden\': message.isForceHidden,\n                                \'msglist-item--billing\': message.billing\n                    }" nxt-touch nxt-touch-callback=checkMessage(message)><div class=msglist-item__panel ng-swipe-left=swipe(message) ng-class="{\'msglist-item__panel--swipe\': swipeMsgId == message.uniqueId}"><span ng-if="::!folder.isSent && !folder.isDrafts && !folder.isSpam" class="icon icon-spam" ng-click="moveToSpam(message, $index);"></span> <span ng-if=::folder.isSpam class="icon icon-not-spam" ng-click="moveToUnSpam(message, $index);"></span> <span ng-if="::!folder.isTrash && !folder.isSpam" class="icon icon-trash" ng-click="moveToTrash(message, $index);" data-track-click-iwa=deleteThread></span> <span ng-if="::folder.isTrash || folder.isSpam" class="icon icon-trash" ng-click="deleteMessages(message, $index);"></span> <span ng-class="message.isStarred ? \'icon-star-full\' : \'icon-star\'" class=icon ng-click="markAsFavorite(message); $event.preventDefault();"></span></div><div class=msglist-item__message__precontainer ng-click=checkMessage(message)><div class=checkbox-container><input type=checkbox class=checkbox ng-attr-id="{{::\'message-\' + message.uniqueId}}" ng-checked=message.checked><label class="checkbox-label msglist-checkbox" ng-attr-for="{{::\'message-\' + message.uniqueId}}" ng-click=$event.preventDefault();></label></div><span class=bubble-container--tutorial-checkbox ng-if="$index == 1" nxt-bubble=10 nxt-bubble-fixed=false nxt-bubble-extra-padd=[221,-135]></span><div nxt-avatar nxt-avatar-list=::message.avatarList nxt-message-sender-info=::message.senderInfo></div></div><div class=msglist-item__message><a class=msglist-item__link ng-click=openMessage(message); ng-swipe-left="swipe(message, \'left\')"><div class=msglist-item__message__sender><i class="icon icon-padlock" ng-if=::message.senderInfo.safe data-tooltip-bubble=0></i> <span ng-bind=::message.fromString></span></div><div class=msglist-item__message__subject><span ng-if="::message.priority == \'high\'" class="icon icon-important"></span><span ng-if=::message.hasAtta class="icon icon-attachment"> </span><span ng-if=::isSearch class=msglist-item__message__subject-folder ng-bind=foldersMap[message.folderId].name></span><span class=msglist-item__message__subject-text ng-bind="::(message.subject || \'(brak tematu)\')"></span></div><div class=msglist-item__message-snippet ng-if="::isSearch && message.snippet" ng-bind-html="::message.snippet | safehtml"></div><div ng-if=message.schema.type nxt-list-schema nxt-list-schema-data=::message.schema></div><div nxt-attachments nxt-attachments-data=message nxt-attachments-collapsed=!isModeAttachments ng-if="::message.atta.length && !message.billing"></div></a><div ng-if=message.billing nxt-billing-panel=message.billing nxt-billing-panel-type=folder nxt-billing-panel-open-message=openMessage(message) class=msglist-item__message__billing></div><div class=msglist-item__message__postcontainer><span ng-bind=::message.formatDate></span><div class=msglist-item__message__postcontainer__icons><span ng-if=message.answered class="icon icon-reply-list"></span><span ng-if=message.forwarded class="icon icon-forward-list"> </span><span ng-if=message.isStarred class="icon icon-star-full"></span></div></div></div></ul><div class=msglist-loading ng-show="(isMoreMessages || isMoreMessagesLoading)"></div><div class=msglist-empty ng-if="messages.length == 0"><div ng-if="::isCorp || isBusinessAccount || isInt" class="icon msglist-empty-icon icon" ng-class="::{\'icon-inbox\'   : folder.id == foldersMap.INBOX,\n                                \'icon-offer\': folder.isShopping,\n                                \'icon-social\'  : folder.isSocial,\n                                \'icon-sent\'    : folder.id == foldersMap.SENT,\n                                \'icon-drafts\'  : folder.id == foldersMap.DRAFTS,\n                                \'icon-trash\'   : folder.id == foldersMap.TRASH,\n                                \'icon-spam\'    : folder.id == foldersMap.SPAM,\n                                \'icon-folder\'  : !folder.isShopping && !folder.isSocial && !folder.isSystem}"></div><div ng-if=!isSearch><h2 ng-if="::isCorp || isBusinessAccount || isInt" class=msglist-empty-header>Ten folder jest pusty</h2><p class=msglist-empty-info ng-if="::(isCorp || isInt) && (folder.isSpam || folder.isTrash)" ng-bind="::\'Wiadomości z&nbsp;folderu \' + folder.name + \' są&nbsp;automatycznie usuwane po&nbsp;30&nbsp;dniach\'"><div ng-if="::!isCorp && !isBusinessAccount && !isInt" nxt-ad-place=box_empty_folder nxt-ad-folder=::folder.name></div></div><div ng-if=isSearch><h2 class=msglist-empty-header>Nie znaleziono wyników&nbsp;pasujących do&nbsp;zapytania</h2><p class=msglist-empty-info ng-if=!isSearchInContent><a href=# ng-click="advancedSearch(); $event.preventDefault();" class=link>Przeszukaj dodatkowo treść wiadomości</a></div></div><div ng-if="::(!isCorp && !isBusinessAccount && !isInt && !isSearch) && (folder.isSpam || folder.isTrash)" ng-show="messages.length == 0" class=msglist-empty-info>Wiadomości z&nbsp;folderu {{::folder.name}}<br>są&nbsp;automatycznie usuwane po&nbsp;30&nbsp;dniach</div></section></div></div><div ng-if="isBottomNav && !folder.isBilling" nxt-bottom-nav></div>'),a.put("o.iplsc.com/n/js/folder/views/main_react.html",'<div class=msglist-section-container><div ng-if=isMobile><div ng-if="speechCommands.length && speech.indicator === \'listening\' && !isNavigationOpen" class=voice-assistant-commands><div class=voice-assistant-commands__content><strong>Wypróbuj jedną z komend:</strong><ul><li ng-repeat="command in speechCommands">{{::command}}</ul></div></div><div ng-show="speech.indicator && !isNavigationOpen" class=voiceAssistantIndicator><div ng-if="speech.indicator === \'listening\'" class=voiceAssistantIndicator__content><div class=speech-animation-wrapper nxt-speech-indicator-animation nxt-animation-name="\'listening\'"></div><p>Nasłuch...</div><div ng-if="speech.indicator === \'speaking\'" class=voiceAssistantIndicator__content><div class=speech-animation-wrapper nxt-speech-indicator-animation nxt-animation-name="\'reading\'"></div><p>Czytam...</div></div><header nxt-stop-touch-move-propagation="" class=msglist-header-container><section class=navigation-header><div class=navigation-header__not-search ng-class="{\'navigation-header--speech-active\': speech.icon === speechIconStates[2]}"><div class="icon icon-hamburger navigation-header__hamburger" ng-class="{\'navigation-header__hamburger--with-counter\': unseenMessageCount}" ng-click="openNavigation(); $event.stopPropagation();"><div nxt-navigation-counter={{unseenMessageCount}} nxt-navigation-counter-sum></div></div><span class=navigation-header__title ng-bind=::folder.name></span><div ng-if="speech.icon !== speechIconStates[0]" class="list voiceAssistant-icon" ng-click="speechToggle(\'list\');" nxt-speech-icon-animation nxt-background-color="\'dark\'"></div><div class=list nxt-bubble=-2 nxt-bubble-extra-padd="[80, 0]"></div><div nxt-search nxt-search-is-expanded=isSearchExpanded></div><div class="icon icon-new-message navigation-header__composition" ng-click=openComposition();></div></div><div class=newsfeed-player><div id=newsfeed-player></div></div></section></header></div><div id=nxt-mail-list class=nxt-mail-list></div><div ng-if=::!isMobile nxt-columns-resize></div></div><div ng-if="isBottomNav && !folder.isBilling" nxt-bottom-nav></div><div nxt-avatar-card></div><div nxt-mail-notification></div><div nxt-tooltip></div><div nxt-tooltip-bubble></div>'),a.put("o.iplsc.com/n/js/folder/views/message_adv.html",'<div nxt-ad-place=box600x450 ng-if=isShowAd()><div class=ad__header ng-if="isShowAdDescription && !isPremiumTest" nxt-adv-close nxt-adv-close-name=giga nxt-adv-close-column-resize=true><div ng-if=!isClose class=ad__header__desc>Reklama<div class="icon icon-close" ng-click=closeAd()></div></div><a ng-if=isClose ng-href={{::urls.TURN_OFF_ADS_GIGABOX}} class="ad__close ad__close--600x450 ad__close--600x450--{{isClose}}" ng-click=click() target=_blank></a></div><div class=premium-test ng-if="isShowAdDescription && isPremiumTest" nxt-adv-close nxt-adv-close-name=big nxt-adv-close-column-resize=true><div ng-click=premiumTest()><p class=premium-test__title>Dzięki reklamie korzystasz z&nbsp;darmowej poczty<p class=premium-test__subtitle>Masz dość?<p class=premium-test__info>Wybierz pocztę bez reklam, a&nbsp;zyskasz:<ul class=premium-test__list><li class=premium-test__list-element>możliwość usunięcia starych mailingów jednym kliknięciem<li class=premium-test__list-eleme