       }\n        .remarketing-message__product__button:hover {\n            color: #fff;\n        }\n        .remarketing-message__product__title, .remarketing-message__product__desc, .remarketing-message__product__price, .remarketing-message__product__button {\n            margin-top: 20px;\n            max-width: 100%;\n            text-align: center;\n        }\n        .remarketing-message__privacy {\n            position: absolute;\n            right: 0;\n            top: 0;\n        }\n        .remarketing-message__product__dsa {\n            display: inline-flex;\n            padding: 3px 5px;\n            align-items: center;\n            gap: 5px;\n            background-color: rgb(241, 243, 248);\n            border-radius: 3px 3px 0 0;\n            position: absolute;\n            left: 0;\n            top: 0;\n            width: auto;\n            min-width: 100px;\n            font-size: 10px;\n            line-height: normal;\n            font-weight: 400;\n            cursor: context-menu;\n            transform: translateY(-20px);\n            white-space: nowrap;\n        }\n        .remarketing-message__product__dsa:hover > span {\n            visibility: visible !important;\n        }\n        .remarketing-message__product__dsa__icon {\n            background-image: url({{::remarketingData.infoIconUrl}});\n            height: 12px;\n            width: 12px;\n\n        }\n        .remarketing-message__product__dsa__text {\n            cursor: context-menu;\n            text-decoration: none;\n            font-size: 10px;\n        }\n        .remarketing-message__product__dsa__info {\n            padding: 10px;\n            justify-content: center;\n            align-items: center;\n            visibility: hidden;\n            position: absolute;\n            z-index: 1;\n            width: 178px;\n            font-size: 10px;\n            top: 18px;\n            left: 0;\n            background-color: rgb(248, 249, 253);\n            box-shadow: r