41 y=50.8286 width=54.2286 height=28.1714 rx=14.0857 stroke=#191919 stroke-width=2 /><path class=next-email-after-move-del__img-dot d="M95.04 64.9152C95.04 70.1916 90.7867 74.469 85.54 74.469C80.2933 74.469 76.04 70.1916 76.04 64.9152C76.04 59.6387 80.2933 55.3613 85.54 55.3613C90.7867 55.3613 95.04 59.6387 95.04 64.9152Z"/></svg><div class=next-email-after-move-del__heading-content><p class=next-email-after-move-del__heading-title><strong>Twoja skrzynka, Twoje zasady!</strong><p class=next-email-after-move-del__heading-subtitle>Wybierz czy chcesz, aby kolejna wiadomość otwierała się automatycznie po usunięciu poprzedniej lub przeniesieniu wiadomości&nbsp;do&nbsp;innego&nbsp;folderu.</div></div><a ng-if=::displayPartnerCreation ng-click=openPartnerCreation() class=next-email-after-move-del__partner-creation target=_blank><img ng-src={{::partnerCreationImage}} alt=Reklama class=next-email-after-move-del__partner-creation-img></a><div class=next-email-after-move-del__switch><div id=switch ng-class="{\'switch--on\': isNextEmailAfterMoveDel}" class=switch ng-click=toggleNextEmailAfterMoveDel()><div id=circle class=switch-circle></div></div><span class=next-email-after-move-del__switch-label>Włącz automatyczne otwieranie kolejnej wiadomości</span></div><div class=next-email-after-move-del__hr></div><p class=next-email-after-move-del__footer>Wybraną opcję możesz w każdej chwili zmienić w ustawieniach konta.</div></div>'),a.put("o.iplsc.com/n/js/folder/views/schema.html",'<div class="schema-list schema-list--{{::schema.type}}"><img class=schema-list__img src={{::img}} alt=logo><div class=schema-list__data><div class=schema-list__title><div class=schema-list__label>{{::label}}</div><div class=schema-list__date title={{::date}}>Do: {{::date}}</div></div><div class=schema-list__desc title={{::schema.desc}}>{{::schema.desc}}</div></div></div>'),a.put("o.iplsc.com/n/js/folder/views/search.html","<section class=search ng-class=\"{\n            'search--expanded': isExpanded,\n            'search--active': isSearchFormActive,\n            'search--less-than-400': widthLessThan400\n"+'        }"><form action=# class=search-form novalidate name=searchForm ng-submit="searchForm.$valid && search(); $event.preventDefault();" nxt-focusout=focusOut();><div class=search-input-container ng-class="{\'search-input-container--advanced-result\': advanceSearchResult}"><div class="input-container input-container--header input-container--touched-line"><input class="input input--header" ng-model=phrase.val type=search id=search autocomplete=off ng-keyup=keyUp($event) ng-keydown=keyDown($event) title="Szukaj wiadomości" ng-focus=open(); accesskey=f tabindex=1000> <input type=submit class=hidden tabindex=-1><hr class=input-line><div class="icon icon-search" ng-click=labelClick($event);></div><label ng-if=!phrase.val class="input-placeholder input-placeholder--header" for=search>Szukaj</label><span ng-if=advanceSearchResult class="input-placeholder input-placeholder--header input-placeholder--filters" ng-click=focusSearchSubject() data-tooltip={{advanceSearchResult}} ng-bind-html=advanceSearchResult></span><div ng-if=isExpanded class="icon icon-close" ng-click=close($event); data-tooltip=Zamknij></div></div></div><div ng-if=isSearchFormActive class=search-container ng-class="{\'search-container--advanced\': isSearchAdvanced}"><ul class=search-suggestions ng-show="isSearchFormActive && !isSearchAdvanced"><li class=search-suggestions__item ng-repeat="suggestion in suggestions | filter: phrase.val | limitTo: phraseLimit" ng-class="{\'search-suggestions__item--selected\': selectedSuggestIndex === $index}" ng-click=searchSuggestion(suggestion);><span class=search-suggestions__item__text ng-bind=::suggestion data-track-click-iwa=useSuggestSearch></span> <span class="icon icon-close" ng-click="removeSuggestion($index); $event.preventDefault(); $event.stopPropagation();" data-tooltip="Usuń z historii"></span><li class=search-suggestions__item ng-show=phrase.val ng-click=searchFrom(phrase.val)><span data-track-click-iwa=useSuggestSearch ng-bind="\'Od: \' + phrase.val"></span><li class=search-suggestions__item ng-show=phrase.val ng-click=searchTo(phrase.val)><span data-track-click-iwa=useSuggestSearch ng-bind="\'Do: \' + phrase.val"></span></ul><div class=search-advanced ng-show="isSearchFormActive && isSearchAdvanced"><div class="input-container input-container--with-select"><ul ui-select class="ui-select-container--search input--select" on-select="pushIWACode(\'searcherOptionFolder\', [$item.name])" ng-model=filters.folder name=search_folder id=search-folder><li ui-select-match>{{$select.selected.name}}<li ui-select-choices repeat="folder.id as folder in folders"><span ng-bind=::folder.name></span></ul><hr class=input-line><span class=ui-select__placeholder>Szukaj w folderze</span></div><div nxt-input nxt-input-placeholder=Od nxt-input-name=search_from ng-model=filters.from ng-focus="pushIWACode(\'searcherOptionFrom\')"></div><div nxt-input nxt-input-placeholder=Do nxt-input-name=search_to ng-model=filters.to ng-focus="pushIWACode(\'searcherOptionTo\')"></div><div nxt-input nxt-input-placeholder="Temat wiadomości" class=search__subject nxt-input-name=search_subject ng-model=phrase.val ng-focus="pushIWACode(\'searcherOptionTopic\')"></div><div class=calendar-wrapper><div nxt-pickadate ng-model=filters.date_from class=date-form-container><div nxt-input nxt-input-placeholder="Zakres dat" nxt-input-name=search_date_form ng-model=filters.date_from nxt-input-pattern=datePattern nxt-input-autocomplete=off ng-focus="openPicker(\'datePickerFromShow\'); pushIWACode(\'searcherOptionDateFrom\')" tabindex=-1></div><div ng-show=datePickerFromShow ng-mouseenter="focusElement(\'.date-from\');" class="pickadate-wrapper date-from"><div class="pickadate pickadate-modal" ng-model=filters.date_from pickadate week-starts-on=1 min-date=minDate max-date=maxDate no-extra-rows></div><div class=pickadate-wrapper__buttons><button type=button class=button ng-click="closePicker(\'datePickerFromShow\')">Zamknij</button><button type=button class="button button--cancel button--margin-left" ng-click="today(\'datePickerFromShow\');">Dziś</button></div></div><div ng-if=filters.date_from ng-click="clearDate(\'date_from\')" class="icon icon-close"></div></div><div nxt-pickadate ng-model=filters.date_to class=date-form-container><div nxt-input nxt-input-placeholder=do nxt-input-name=search_date_to ng-model=filters.date_to nxt-input-pattern=datePattern nxt-input-autocomplete=off ng-focus="openPicker(\'datePickerToShow\'); pushIWACode(\'searcherOptionDateTo\')" tabindex=-1></div><div ng-show=datePickerToShow ng-mouseenter="focusElement(\'.date-to\');" class="pickadate-wrapper date-to"><div class="pickadate pickadate-modal" ng-model=filters.date_to pickadate week-starts-on=1 min-date=minDate max-date=maxDate no-extra-rows></div><div class=pickadate-wrapper__buttons><button type=button class=button ng-click="closePicker(\'datePickerToShow\')">Zamknij</button><button type=button class="button button--cancel button--margin-left" ng-click="today(\'datePickerToShow\')">Dziś</button></div></div><div ng-if=filters.date_to ng-click="clearDate(\'date_to\')" class="icon icon-close"></div></div></div><div class=search__checkbox-container><input type=checkbox class=checkbox name=search_attachments id=search-attachments ng-model=filters.with_attachments data-track-change=searcherOptionAttach data-track-change-iwa=searcherOptionAttach><label for=search-attachments class=checkbox-label>Pokaż tylko wiadomości z załącznikami</label></div><div class=search__checkbox-container><input type=checkbox class=checkbox ng-model=filters.isSearchInContent id=search-in-content-advanced><label for=search-in-content-advanced class=checkbox-label>Szukaj w treści wiadomości</label></div><div class=search__buttons-containter ng-show="isExpanded && isSearchAdvanced"><button type=submit class=button>Szukaj</button><button type=button class="button button--cancel but