class Roll {
    #movementValue = 300;
    #standardDuration = 0.3;
    #standardDelay = 0;
    #repeatTime = 2500


    constructor(imgClass) {
        this.repeatTimeline
        this.imgClass = imgClass;
        this.currentImg = 1;
        this.images = document.querySelectorAll(imgClass)
        this.countImages = this.images.length;
    

       this.setPrevState()

       this.repeatTimeline = setInterval(() =>  this.slideAnimate(),this.#repeatTime)
        
        //this.setLeftArrow()
        
        //this.setRightArrow()
    }

    getBgStateForSlide(slideIndex) {
        if (slideIndex === 1) {
            return { y: 52, height: 450 };
        }

        if (slideIndex === 2) {
            return { y: 63, height: 482 };
        }

        return { y: 0, height: 568 };
    }

    getForegroundStateForSlide(slideIndex) {
        if (slideIndex === 1) {
            return { logoY: 170, text1Y: 238, ctaY: 361, discY: 455 };
        }

        if (slideIndex === 2) {
            return { logoY: 147, text1Y: 215, ctaY: 389, discY: 480 };
        }

        return { logoY: 147, text1Y: 215, ctaY: 389, discY: 525 };
    }

    syncForegroundWithSlide(forceBase = false) {
        const isHovered = document.querySelector('.ad-container')?.classList.contains('is-hovered');
        const shouldUseBase = forceBase || isHovered;
        const state = shouldUseBase
            ? { logoY: 147, text1Y: 215, ctaY: 389, discY: 525 }
            : this.getForegroundStateForSlide(this.currentImg);

        gsap.to('.logo', { y: state.logoY - 147, duration: this.#standardDuration, ease: Power0.easeNone });
        gsap.to('.text1', { y: state.text1Y - 215, duration: this.#standardDuration, ease: Power0.easeNone });
        gsap.to('.cta', { y: state.ctaY - 389, duration: this.#standardDuration, ease: Power0.easeNone });
        gsap.to('.disc', { y: state.discY - 525, duration: this.#standardDuration, ease: Power0.easeNone });

        const showText2 = shouldUseBase || this.currentImg === 2;
        gsap.killTweensOf('.text2');
        if (showText2) {
            const targetY = shouldUseBase ? -12 : 0;
            const currentOpacity = Number(gsap.getProperty('.text2', 'opacity')) || 0;
            const keepVisibleAndMoveYOnly = this.currentImg === 2 && currentOpacity > 0.9;

            if (keepVisibleAndMoveYOnly) {
                gsap.to('.text2', {
                    opacity: 1,
                    // y: targetY,
                    scale: 1,
                    duration: this.#standardDuration,
                    ease: Power1.easeOut
                });
                return;
            }

            gsap.fromTo('.text2',
                { opacity: 0, y: 18, scale: 0.97 },
                { opacity: 1, scale: 1, duration: 0.45, ease: Power2.easeOut }
            );
            return;
        }

        gsap.to('.text2', { opacity: 0, y: 12, duration: 0.2, ease: Power1.easeOut });
    }

    syncBgWithSlide(forceBase = false) {
        const bg = document.querySelector('.bg');
        if (!bg) return;

        const isHovered = document.querySelector('.ad-container')?.classList.contains('is-hovered');
        const shouldUseBase = forceBase || isHovered;
        const state = shouldUseBase ? { y: 0, height: 568 } : this.getBgStateForSlide(this.currentImg);
        gsap.to(bg, {
            y: state.y,
            height: state.height,
            duration: this.#standardDuration,
            ease: Power0.easeNone
        });
    }

    setPrevState() {
        gsap.set( this.images , {opacity:0})

        gsap.set( this.imgClass + 1 , {opacity: 1})
        gsap.set('.circle',{opacity:0.2})
        gsap.set('.circle1',{opacity:1})
        this.syncBgWithSlide()
        this.syncForegroundWithSlide()

    }

    setPrev() {
        this.currentImg --;

        if(this.currentImg <= 0)
            this.currentImg = this.countImages;
    }

    setNext() {
        this.currentImg ++;

        if(this.currentImg > this.countImages)
            this.currentImg = 1;
    }

    stopAnim() {
        clearInterval(this.repeatTimeline)
    }
    resetTimer() {
        clearInterval(this.repeatTimeline)
        this.repeatTimeline = setInterval(() =>  this.slideAnimate(),this.#repeatTime)
    }
    

    slideAnimate(dir = 1) {
        const that = this;

        gsap.to(that.imgClass + that.currentImg, {
            opacity: 0, 
            duration: that.#standardDuration,
            delay: that.#standardDelay,
            ease:Power0.easeNone
        })

        gsap.to('.circle' + that.currentImg, {
            opacity: 0.2, 
            duration: that.#standardDuration,
            delay: that.#standardDelay,
            ease:Power0.easeNone
        })

        if(dir)
            that.setNext()
        else
            that.setPrev()

        that.syncBgWithSlide()
        that.syncForegroundWithSlide()

        gsap.set(that.imgClass + that.currentImg, {
            opacity: 0, 
        }) 

        gsap.to('.circle' + that.currentImg, {
            opacity: 1, 
            duration: that.#standardDuration,
            delay: that.#standardDelay,
            ease:Power0.easeNone
        })
        
        gsap.to(that.imgClass + that.currentImg, {
            opacity: 1, 
            duration: that.#standardDuration,
            delay: that.#standardDelay,
            ease:Power0.easeNone,
            onComplete: () => {
                that.resetTimer()
            }
        })
    }

    showThis(next) {
        const that = this;

        gsap.to(that.imgClass + that.currentImg, {
            opacity: 0, 
            duration: that.#standardDuration,
            delay: that.#standardDelay,
            ease:Power0.easeNone
        })

        gsap.to('.circle' + that.currentImg, {
            opacity: 0.2, 
            duration: that.#standardDuration,
            delay: that.#standardDelay,
            ease:Power0.easeNone
        })

       that.currentImg = next; 
       that.syncBgWithSlide();
       that.syncForegroundWithSlide();

        gsap.set(that.imgClass + that.currentImg, {
            opacity: 0, 
        }) 

        gsap.to('.circle' + that.currentImg, {
            opacity: 1, 
            duration: that.#standardDuration,
            delay: that.#standardDelay,
            ease:Power0.easeNone
        })
        
        gsap.to(that.imgClass + that.currentImg, {
            opacity: 1, 
            duration: that.#standardDuration,
            delay: that.#standardDelay,
            ease:Power0.easeNone,
            onComplete: () => {
                that.resetTimer()
            }
        })
    }


    setLeftArrow() {
        this.slideAnimate()
    }

    setRightArrow() {
        this.slideAnimate(-1)
    }
}

const roll = new Roll('.slaid')
window.roll = roll;

document.querySelectorAll('.circle').forEach((circ,i) => {
    circ.addEventListener('click', () => {
        roll.showThis(i+1)
    })
})
