    "@types/chrome": "^0.1.37",
    "@types/node": "^24.10.1",
    "esbuild": "^0.27.3",
    "jsdom": "^28.1.0",
    "svelte": "^5.45.2",
    "svelte-check": "^4.3.4",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
