{
    "manifest_version": 3,
    "name": "CheckMailPlugin",
    "version": "0.1.0",
    "description": "Phishing detection assistant — extracts email content from Gmail for analysis.",
    "permissions": [],
    "host_permissions": [
        "https://mail.google.com/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://mail.google.com/mail/*?*view=om*"
            ],
            "js": [
                "show-original-content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "CheckMailPlugin",
        "default_popup": "index.html"
    },
    "background": {
        "service_worker": "service-worker.js"
    }
}