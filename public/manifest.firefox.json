{
    "manifest_version": 3,
    "name": "CheckMailPlugin",
    "version": "0.1.0",
    "description": "Phishing detection assistant — extracts email content from Gmail for analysis.",
    "permissions": [],
    "host_permissions": [
        "https://mail.google.com/*",
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": [
                "https://mail.google.com/mail/*?*view=om*"
            ],
            "js": [
                "show-original-content.js"
            ],
            "run_at": "document_idle"
        }
    ],
    "action": {
        "default_title": "CheckMailPlugin",
        "default_popup": "index.html"
    },
    "background": {
        "scripts": [
            "service-worker.js"
        ]
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "radoslaw.bujny@gmail.com",
            "strict_min_version": "109.0"
        }
    }
}